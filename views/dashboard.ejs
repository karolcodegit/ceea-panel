  <!DOCTYPE html>
  <html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title><%= title || 'Moje kursy — CEEA' %></title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <%- include('partials/header') %>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8">
        <h1 class="text-2xl font-bold text-gray-900">Twoje kursy</h1>
        <p class="text-gray-500 mt-1">Materiały z kursów, do których masz dostęp</p>
      </div>

      <% const isEmpty = active.length === 0 && archive.length === 0; %>

      <% if (isEmpty) { %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 p-12 text-center">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">Brak kursów</h3>
          <p class="text-gray-500 mb-6">Nie masz jeszcze dostępu do żadnego kursu.</p>
          <a href="https://ceea.org.pl" class="inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium">
            Zapisz się na kurs
          </a>
        </div>
      <% } %>

      <%# --- jedna karta kursu: użyta w obu sekcjach --- %>
      <% const courseCard = (course, isActive) => { %>
        <div class="bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
          <div class="<%= isActive ? 'bg-gradient-to-r from-red-600 to-red-700' : 'bg-gradient-to-r from-gray-500 to-gray-600' %> px-6 py-5">
            <div class="flex items-center justify-between">
              <div>
                <h2 class="text-xl font-bold text-white"><%= course.nameCourse %></h2>
                <p class="<%= isActive ? 'text-red-100' : 'text-gray-200' %> text-sm mt-1"><%= course.date %></p>
              </div>
              <div class="hidden sm:flex items-center gap-2 px-3 py-1 bg-white/20 rounded-full">
                <span class="w-2 h-2 <%= isActive ? 'bg-green-400' : 'bg-gray-300' %> rounded-full"></span>
                <span class="text-white text-sm font-medium"><%= isActive ? 'Aktywny' : 'Archiwum' %></span>
              </div>
            </div>
          </div>

          <div class="divide-y divide-gray-100">
            <% if (!course.materials || course.materials.length === 0) { %>
              <div class="p-6 text-center text-gray-500">Brak materiałów w tym kursie.</div>
            <% } else { %>
              <% course.materials.forEach(mat => { %>
                <%
                const isCloudinary = mat.url.includes('res.cloudinary.com');
                const safeName = mat.title.replace(/[^\w\dąćęłńóśźżĄĆĘŁŃÓŚŹŻ-]+/g, '-');
                const downloadUrl = isCloudinary
                  ? mat.url.replace('/upload/', '/upload/fl_attachment:' + safeName + '/')
                  : mat.url;
                const href = (mat.type === 'pdf' || mat.type === 'video') ? downloadUrl : mat.url;
              %>
                <div class="flex items-center gap-4 p-4 hover:bg-gray-50 transition-colors group">
                  <div class="flex-shrink-0">
                    <% if (mat.type === 'pdf') { %>
                      <div class="w-12 h-12 bg-red-50 rounded-xl flex items-center justify-center group-hover:bg-red-100 transition-colors">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                      </div>
                    <% } else if (mat.type === 'video') { %>
                      <div class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center group-hover:bg-blue-100 transition-colors">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      </div>
                    <% } else if (mat.type === 'jpg') { %>
                      <div class="w-12 h-12 bg-green-50 rounded-xl flex items-center justify-center group-hover:bg-green-100 transition-colors">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                      </div>
                    <% } else { %>
                      <div class="w-12 h-12 bg-gray-50 rounded-xl flex items-center justify-center group-hover:bg-gray-100 transition-colors">
                        <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                        </svg>
                      </div>
                    <% } %>
                  </div>

                  <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-semibold text-gray-900 truncate"><%= mat.title %></h3>
                    <p class="text-xs text-gray-500 mt-0.5">
                      <%= mat.type === 'pdf' ? 'Dokument PDF' : mat.type === 'video' ? 'Film wideo' : mat.type === 'jpg' ? 'Zdjęcie' : 'Link' %>
                    </p>
                  </div>

                  <a href="<%= href %>" target="_blank" rel="noopener noreferrer"
                    class="flex-shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium transition-all
                    <%= mat.type === 'pdf' ? 'bg-red-600 text-white hover:bg-red-700' :
                      mat.type === 'video' ? 'bg-blue-600 text-white hover:bg-blue-700' :
                      'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
                    <% if (mat.type === 'pdf') { %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                      </svg>
                      Pobierz
                    <% } else if (mat.type === 'video') { %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                      </svg>
                      Odtwórz
                    <% } else { %>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                      </svg>
                      Otwórz
                    <% } %>
                  </a>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      <% } %>

      <%# --- AKTYWNE --- %>
      <% if (active.length > 0) { %>
        <section class="space-y-6">
          <% active.forEach(course => { %><%- courseCard(course, true) %><% }) %>
        </section>
      <% } %>

      <%# --- ARCHIWUM --- %>
      <% if (archive.length > 0) { %>
        <h2 class="text-lg font-semibold text-gray-700 mt-12 mb-4">Archiwum</h2>
        <section class="space-y-6">
          <% archive.forEach(course => { %><%- courseCard(course, false) %><% }) %>
        </section>
      <% } %>
    </main>

    <%- include('partials/footer') %>
  </body>
  </html>