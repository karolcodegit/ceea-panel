<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title>Administratorzy — Panel CEEA</title>
    <style>
      .badge { @apply inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium; }
      .twofa-on { @apply bg-green-100 dark:bg-green-500/10 text-green-700 dark:text-green-300; }
      .twofa-off { @apply bg-yellow-100 dark:bg-yellow-500/10 text-yellow-700 dark:text-yellow-300; }
    </style>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-[#0B1120] transition-colors">
    <%- include('partials/admin-nav', { active: 'administratorzy' }) %>
    <% const mod = (typeof adminModules !== 'undefined' ? adminModules : []).find(m => m.key === 'administratorzy') || { name: 'Administratorzy', desc: '' }; %>

    <div class="lg:pl-64">
      <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <% const q = locals.query || {}; %>

        <div class="mb-6">
          <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white"><%= mod.name %></h1>
          <p class="text-gray-500 dark:text-slate-400"><%= mod.desc %></p>
        </div>

        <% if (q.success) { %>
          <div class="mb-4 p-3 bg-green-50 dark:bg-green-500/10 text-green-700 dark:text-green-300 rounded-lg text-sm"><%= q.success %></div>
        <% } %>
        <% if (q.error || locals.error) { %>
          <div class="mb-4 p-3 bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-300 rounded-lg text-sm"><%= q.error || locals.error %></div>
        <% } %>

        <!-- Dodawanie admina -->
        <div class="no-print bg-white dark:bg-slate-800/80 rounded-2xl border border-gray-200 dark:border-slate-700/60 shadow-sm p-4 sm:p-5 mb-6">
          <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-4">Dodaj administratora</h2>
          <form method="POST" action="<%= adminPrefix %>/admini" class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
            <div>
              <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1.5">Email</label>
              <input type="email" name="email" required placeholder="admin@ceea.org.pl"
                class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none focus:border-red-400 dark:focus:border-red-500" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1.5">Imię i nazwisko</label>
              <input type="text" name="name" placeholder="Jan Kowalski"
                class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none focus:border-red-400 dark:focus:border-red-500" />
            </div>
            <button type="submit" class="px-4 py-2.5 bg-red-600 text-white rounded-xl text-sm font-medium hover:bg-red-700 transition-colors">
              + Dodaj
            </button>
          </form>
          <p class="mt-3 text-xs text-gray-400 dark:text-slate-500">
            Nowy administrator zaloguje się emailem i zeskanuje kod QR przy pierwszym logowaniu (model TOTP – bez hasła).
          </p>
        </div>

        <!-- Tabela -->
        <div id="adminsTable"></div>

      </main>
    </div>

    <script>
      const DATA = <%- JSON.stringify(admins) %>;
      const CURRENT = <%- JSON.stringify(currentEmail) %>;

      const table = new DataTable('#adminsTable', {
        csvFilename: 'administratorzy.csv',
        pageSize: 10,
        emptyText: 'Brak administratorów.',
        columns: [
          { key: 'email', label: 'Email',
            sortValue: r => r.email,
            render: a => `
              <div class="font-medium text-gray-900 dark:text-white">${a.email}</div>
              ${a.email === CURRENT ? '<span class="text-xs text-red-500">(Ty)</span>' : ''}` },
          { key: 'name', label: 'Imię i nazwisko',
            sortValue: r => r.name || '',
            render: a => `<span class="text-gray-700 dark:text-slate-300">${a.name || '—'}</span>` },
          { key: 'qr_setup', label: '2FA',
            sortValue: r => (r.qr_setup ? 1 : 0),
            render: a => a.qr_setup
              ? '<span class="badge twofa-on">✓ Skonfigurowane</span>'
              : '<span class="badge twofa-off">Do konfiguracji</span>' },
          { key: 'created_at', label: 'Utworzono',
            sortValue: r => new Date(r.created_at),
            render: a => `<span class="text-xs text-gray-500 dark:text-slate-400">${new Date(a.created_at).toLocaleDateString('pl-PL')}</span>` },
          { key: '_actions', label: 'Akcje', align: 'right', sortable: false,
            render: a => `
              <form method="POST" action="<%= adminPrefix %>/admini/${encodeURIComponent(a.email)}/reset-2fa" class="inline"
                onsubmit="return confirm('Zresetować 2FA dla ${a.email}?')">
                <button class="px-2 py-1 bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200 rounded text-xs font-medium hover:bg-gray-200">Reset 2FA</button>
              </form>
              <form method="POST" action="<%= adminPrefix %>/admini/${encodeURIComponent(a.email)}/usun" class="inline"
                onsubmit="return confirm('Usunąć ${a.email}? Tej operacji nie można cofnąć.')">
                <button ${a.email === CURRENT || DATA.length <= 1 ? 'disabled' : ''}
                  class="px-2 py-1 rounded text-xs font-medium ${a.email === CURRENT || DATA.length <= 1
                    ? 'bg-gray-100 dark:bg-slate-700 text-gray-400 cursor-not-allowed'
                    : 'bg-red-100 dark:bg-red-500/10 text-red-700 dark:text-red-300 hover:bg-red-200'}">
                  Usuń
                </button>
              </form>` },
        ],
      });

      table.setRows(DATA);
    </script>
  </body>
</html>
