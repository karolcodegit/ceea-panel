<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title>Administratorzy — Panel CEEA</title>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-[#0B1120] transition-colors">
    <%- include('partials/admin-nav', { active: 'administratorzy' }) %>
    <%- include('partials/header') %>

    <div class="lg:pl-64 pt-16">
      <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <% const q = locals.query || {}; %>

        <% if (q.success) { %>
          <div class="mb-4 p-3 bg-green-50 dark:bg-green-500/10 text-green-700 dark:text-green-300 rounded-lg text-sm"><%= q.success %></div>
        <% } %>
        <% if (q.error || locals.error) { %>
          <div class="mb-4 p-3 bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-300 rounded-lg text-sm"><%= q.error || locals.error %></div>
        <% } %>

        <%# Karta: dodawanie admina %>
        <section class="module-card p-4 sm:p-5 mb-6">
          <h2 class="module-title mb-4">Dodaj administratora</h2>
          <form method="POST" action="<%= adminPrefix %>/admini" class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end">
            <div>
              <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1.5">Email</label>
              <input type="email" name="email" required placeholder="admin@ceea.org.pl"
                class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none focus:border-red-400 dark:focus:border-red-500" />
            </div>
            <div>
              <label class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1.5">Imię i nazwisko</label>
              <input type="text" name="name" placeholder="Jan Kowalski"
                class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none focus:border-red-400 dark:focus:border-red-500" />
            </div>
            <button type="submit" class="btn btn-sm btn-primary whitespace-nowrap">+ Dodaj</button>
          </form>
          <p class="mt-3 text-xs text-gray-400 dark:text-slate-500">
            Nowy administrator zaloguje się emailem i zeskanuje kod QR przy pierwszym logowaniu (model TOTP – bez hasła).
          </p>
        </section>

        <%# Karta: statystyki + lista %>
        <section class="module-card p-4 sm:p-5">
          <h2 class="module-title mb-4">Administratorzy <span class="text-xs font-normal text-gray-400 dark:text-slate-500">(<%= (admins || []).length %>)</span></h2>

          <%# Kafelki statystyk (jak Total Members / Active Keys w FlowAI) %>
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-5">
            <div class="stat-tile">
              <span class="stat-tile-icon">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a3 3 0 11-3-3"/></svg>
              </span>
              <div>
                <p class="stat-tile-label">Administratorzy</p>
                <p class="stat-tile-value" id="statTotal">0</p>
              </div>
            </div>
            <div class="stat-tile">
              <span class="stat-tile-icon">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </span>
              <div>
                <p class="stat-tile-label">2FA skonfigurowane</p>
                <p class="stat-tile-value" id="stat2fa">0</p>
              </div>
            </div>
            <div class="stat-tile">
              <span class="stat-tile-icon">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              </span>
              <div>
                <p class="stat-tile-label">Super admini</p>
                <p class="stat-tile-value" id="statSuper">0</p>
              </div>
            </div>
            <div class="stat-tile">
              <span class="stat-tile-icon">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </span>
              <div>
                <p class="stat-tile-label">Ostatnio aktywni (7 dni)</p>
                <p class="stat-tile-value" id="statActive">0</p>
              </div>
            </div>
          </div>

          <div id="adminsTable"></div>
        </section>

      </main>
    </div>

    <script>
      const DATA = <%- JSON.stringify(admins) %>;
      const CURRENT = <%- JSON.stringify(currentEmail) %>;

      // ── Czas względny: "2 godz. temu", "wczoraj, 14:32", "13.10.2026" ──
      function relTime(d) {
        if (!d) return '<span class="text-gray-400">—</span>';
        const t = new Date(d);
        const diff = Date.now() - t.getTime();
        const min = Math.floor(diff / 60000);
        const time = t.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
        if (min < 1) return '<span class="text-green-600 dark:text-green-400 font-medium">przed chwilą</span>';
        if (min < 60) return `<span class="text-green-600 dark:text-green-400 font-medium">${min} min temu</span>`;
        const hours = Math.floor(min / 60);
        if (hours < 24) return `<span>${hours} godz. temu</span>`;
        const days = Math.floor(hours / 24);
        if (days === 1) return `<span>wczoraj, ${time}</span>`;
        if (days < 7) return `<span>${days} dni temu</span>`;
        return `<span>${t.toLocaleDateString('pl-PL')}</span>`;
      }

      // ── Statystyki do kafelków ──
      (function () {
        const weekAgo = Date.now() - 7 * 864e5;
        document.getElementById('statTotal').textContent = DATA.length;
        document.getElementById('stat2fa').textContent = DATA.filter(a => a.qr_setup).length;
        document.getElementById('statSuper').textContent = DATA.filter(a => a.is_super).length;
        document.getElementById('statActive').textContent = DATA.filter(a => a.last_login && new Date(a.last_login).getTime() >= weekAgo).length;
      })();

      const table = new DataTable('#adminsTable', {
        csvFilename: 'administratorzy.csv',
        pageSize: 10,
        emptyText: 'Brak administratorów.',
        columns: [
          { key: 'email', label: 'Email',
            sortValue: r => r.email,
            render: a => `
              <div class="font-medium text-gray-900 dark:text-white break-all">${a.email}</div>
              ${a.email === CURRENT ? '<span class="text-xs text-red-500">(Ty)</span>' : ''}` },
          { key: 'name', label: 'Imię i nazwisko',
            sortValue: r => r.name || '',
            render: a => `
              <span class="text-gray-700 dark:text-slate-300">${a.name || '—'}</span>
              ${a.is_super ? ' <span class="badge badge-purple align-middle">super</span>' : ''}` },
          { key: 'qr_setup', label: '2FA',
            sortValue: r => (a => a.qr_setup ? 1 : 0)(r),
            render: a => a.qr_setup
              ? '<span class="badge badge-green">✓ Skonfigurowane</span>'
              : '<span class="badge badge-amber">Do konfiguracji</span>' },
          { key: 'last_login', label: 'Ostatnie logowanie', sortable: true,
            sortValue: r => r.last_login ? new Date(r.last_login).getTime() : 0,
            csvValue: r => r.last_login || '',
            render: a => `<span class="text-xs text-gray-600 dark:text-slate-400 whitespace-nowrap">${relTime(a.last_login)}</span>` },
          { key: 'created_at', label: 'Utworzono',
            sortValue: r => new Date(r.created_at),
            render: a => `<span class="text-xs text-gray-500 dark:text-slate-400">${new Date(a.created_at).toLocaleDateString('pl-PL')}</span>` },
          { key: '_actions', label: 'Akcje', align: 'right', sortable: false,
            render: a => {
              const locked = a.email === CURRENT || DATA.length <= 1;
              return `<div class="btn-group">` +
                `<form method="POST" action="<%= adminPrefix %>/admini/${encodeURIComponent(a.email)}/reset-2fa" onsubmit="return confirm('Zresetować 2FA dla ${a.email}?')">` +
                  `<button class="btn btn-xs btn-neutral">Reset 2FA</button></form>` +
                `<form method="POST" action="<%= adminPrefix %>/admini/${encodeURIComponent(a.email)}/usun" onsubmit="return confirm('Usunąć ${a.email}? Tej operacji nie można cofnąć.')">` +
                  `<button ${locked ? 'disabled' : ''} class="btn btn-xs btn-delete">Usuń</button></form>` +
                `</div>`;
            } },
        ],
      });

      table.setRows(DATA);
    </script>
  </body>
</html>