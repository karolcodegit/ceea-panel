<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title>Kursy — Admin CEEA</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <%- include('partials/admin-nav', { active: 'kursy' }) %>
    <div class="lg:pl-64">
      <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
        <div class="flex items-center justify-between mb-2">
          <h1 class="text-2xl font-bold text-gray-900">Kursy</h1>
          <a
            href="<%= adminPrefix %>/kursy"
            class="text-sm text-gray-500 hover:text-gray-700"
            >Odśwież</a
          >
        </div>
        <p class="text-sm text-gray-400 mb-8">
          Kursy pochodzą z DatoCMS — nowy kurs dodajesz w CMS, pojawi się tutaj
          automatycznie.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          <% courses.forEach(course => { %>
          <div
            class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col"
          >
            <% if (course.image?.url) { %>
            <img
              src="<%= course.image.url %>"
              alt="<%= course.nameCourse %>"
              class="w-full h-40 object-cover"
            />
            <% } %>
            <div class="p-5 flex flex-col flex-1">
              <div class="flex items-start justify-between gap-3 mb-2">
                <h2 class="font-semibold text-gray-900 leading-snug">
                  <%= course.nameCourse %>
                </h2>
                <span
                  class="shrink-0 text-xs font-medium px-2.5 py-1 rounded-full <%= course.available ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-500' %>"
                >
                  <%= course.available ? 'Aktywny' : 'Archiwum' %>
                </span>
              </div>
              <p class="text-sm text-gray-400 mb-1"><%= course.date %></p>
              <p class="text-xs text-gray-400 mb-4">
                <%= course.materialsCount %> materiałów · <%=
                course.participantsCount %> uczestników
              </p>
              <div class="mt-auto flex gap-4">
                <a
                  href="<%= adminPrefix %>/kursy/<%= course.id %>/materials"
                  class="text-red-600 hover:text-red-700 text-sm font-medium"
                  >Materiały</a
                >
                <a
                  href="<%= adminPrefix %>/kursy/<%= course.id %>/uczestnicy"
                  class="text-blue-600 hover:text-blue-700 text-sm font-medium"
                  >Uczestnicy</a
                >
              </div>
            </div>
          </div>
          <% }) %>
        </div>
      </main>
    </div>
  </body>
</html>
