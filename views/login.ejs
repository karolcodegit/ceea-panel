<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title><%= title || 'Panel uczestnika — CEEA' %></title>
    <style>
      /* --- Widoki logowania --- */
      .login-view {
        display: none;
      }
      .login-view.active {
        display: block;
        animation: viewIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
      }
      @keyframes viewIn {
        from {
          opacity: 0;
          transform: translateY(14px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .btn-spinner {
        display: inline-block;
        width: 18px;
        height: 18px;
        border: 2.5px solid rgba(255, 255, 255, 0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }

      .sent-wrap {
        position: relative;
        width: 96px;
        height: 96px;
        margin: 0 auto;
      }
      .sent-circle {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 30px rgba(220, 38, 38, 0.35);
        animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      }
      @keyframes popIn {
        from {
          transform: scale(0.4);
          opacity: 0;
        }
        to {
          transform: scale(1);
          opacity: 1;
        }
      }
      .sent-ring {
        position: absolute;
        inset: -10px;
        border: 2px dashed rgba(220, 38, 38, 0.4);
        border-radius: 50%;
        animation: ringSpin 14s linear infinite;
      }
      @keyframes ringSpin {
        to {
          transform: rotate(360deg);
        }
      }
      .sent-badge {
        position: absolute;
        right: -2px;
        bottom: -2px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #16a34a;
        border: 3px solid #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: badgeIn 0.4s 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      }
      @keyframes badgeIn {
        from {
          transform: scale(0);
        }
        to {
          transform: scale(1);
        }
      }
      .sent-envelope {
        animation: floatY 3s 0.6s ease-in-out infinite;
      }
      @keyframes floatY {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-5px);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .login-view.active,
        .sent-circle,
        .sent-badge,
        .sent-ring,
        .sent-envelope {
          animation: none;
        }
      }
    </style>
  </head>

  <body class="h-screen w-full flex overflow-hidden">
    <!-- LEWA STRONA -->
    <div
      class="hidden lg:flex lg:w-1/2 xl:w-5/12 bg-gradient-to-br from-red-600 via-red-700 to-red-900 relative items-center justify-center p-12 overflow-hidden"
    >
      <div class="absolute top-8 left-8 z-20">
        <img
          src="/images/logo-header.png"
          alt="CEEA"
          class="md:h-12 h-8 w-auto brightness-0 invert opacity-90"
        />
      </div>

      <div class="absolute inset-0 opacity-10">
        <svg
          class="w-full h-full"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
        >
          <pattern
            id="grid"
            width="10"
            height="10"
            patternUnits="userSpaceOnUse"
          >
            <circle cx="5" cy="5" r="1" fill="white" />
          </pattern>
          <rect width="100" height="100" fill="url(#grid)"></rect>
        </svg>
      </div>

      <div
        class="absolute -top-20 -right-20 w-96 h-96 bg-white/5 rounded-full blur-3xl"
      ></div>
      <div
        class="absolute -bottom-20 -left-20 w-72 h-72 bg-white/5 rounded-full blur-3xl"
      ></div>

      <div class="relative z-10 text-white max-w-md">
        <!-- <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 backdrop-blur-sm rounded-full mb-6">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        <span class="text-sm font-medium">Panel aktywny</span>
      </div> -->

        <h1 class="text-5xl font-bold mb-2 leading-tight">
          Panel<br />
          <span class="text-red-200">uczestnika</span>
        </h1>

        <p class="text-red-100 text-lg mb-10 leading-relaxed">
          Dostęp do materiałów, certyfikatów<br />i zapisów na kursy.
        </p>

        <div class="space-y-3">
          <div
            class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-sm rounded-xl border border-white/10"
          >
            <div
              class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                />
              </svg>
            </div>
            <div>
              <p class="font-semibold">Materiały kursowe</p>
              <p class="text-red-200 text-sm">PDF, wideo, prezentacje</p>
            </div>
          </div>

          <div
            class="flex items-center gap-4 p-4 bg-white/10 backdrop-blur-sm rounded-xl border border-white/10"
          >
            <div
              class="w-10 h-10 bg-white/20 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            </div>
            <div>
              <p class="font-semibold">Certyfikaty</p>
              <p class="text-red-200 text-sm">Pobierz po ukończeniu kursu</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- PRAWA STRONA -->
    <div
      class="w-full lg:w-1/2 xl:w-7/12 flex items-center justify-center relative overflow-hidden"
      style="
        background: linear-gradient(
          135deg,
          #fef2f2 0%,
          #ffffff 50%,
          #eff6ff 100%
        );
      "
    >
      <div
        class="absolute inset-0 opacity-10"
        style="
          background-image: radial-gradient(#dc2626 1px, transparent 1px);
          background-size: 20px 20px;
        "
      ></div>

      <!-- Kolorowe kółka -->
      <div
        class="absolute top-10 right-10 w-32 h-32 bg-red-200 rounded-full blur-3xl opacity-30"
      ></div>
      <div
        class="absolute bottom-10 left-10 w-32 h-32 bg-blue-200 rounded-full blur-3xl opacity-30"
      ></div>

      <div class="relative z-10 w-full max-w-md px-6 lg:px-0">
        <div
          class="bg-white/80 backdrop-blur-sm rounded-2xl shadow-2xl shadow-gray-200/50 p-8 lg:p-10 border border-gray-100"
        >
          <div class="lg:hidden flex justify-center mb-12">
            <img
              src="/images/logo-header-color-black.jpg"
              alt="CEEA"
              class="h-8 w-auto"
            />
          </div>

          <% if (error) { %>
          <div
            class="mb-6 p-4 bg-red-50 border border-red-200 rounded-xl flex items-start gap-3"
          >
            <svg
              class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <p class="text-red-700 text-sm"><%= error %></p>
          </div>
          <% } %> <% if (message) { %>
          <div
            class="mb-6 p-4 bg-green-50 border border-green-200 rounded-xl flex items-start gap-3"
          >
            <svg
              class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              />
            </svg>
            <p class="text-green-700 text-sm"><%= message %></p>
          </div>
          <% } %>

          <!-- WIDOK 1: email -->
          <div id="view-email" class="login-view active">
            <div class="mb-8 text-center">
              <h2 class="text-2xl font-bold text-gray-900 mb-2">Zaloguj się</h2>
              <p class="text-gray-500 text-sm">
                Wprowadź email podany przy rejestracji na kurs
              </p>
            </div>

            <form id="form-email" class="space-y-5">
              <div>
                <label
                  for="email"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Adres email</label
                >
                <div class="relative">
                  <div
                    class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                  >
                    <svg
                      class="h-5 w-5 text-gray-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"
                      />
                    </svg>
                  </div>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="twoj@email.com"
                    class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-colors text-gray-900 placeholder-gray-400 bg-gray-50/50"
                  />
                </div>
              </div>

              <button
                type="submit"
                id="btn-email"
                class="w-full py-3 px-4 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-red-500/30 hover:shadow-red-500/50 hover:-translate-y-0.5 flex items-center justify-center"
              >
                <span class="btn-label">Dalej</span>
              </button>
            </form>

            <div class="mt-6 pt-6 border-t border-gray-100">
              <% if (typeof registrationUrl !== 'undefined' && registrationUrl)
              { %>
              <p class="text-sm text-gray-500 text-center">
                Nie masz konta?
                <a
                  href="<%= registrationUrl %>"
                  class="text-red-600 hover:text-red-700 font-semibold"
                  >Zapisz się na kurs</a
                >
              </p>
              <% } else { %>
              <p class="text-sm text-gray-400 text-center">
                Nie masz konta? Rejestracja będzie dostępna, gdy kurs zostanie
                aktywowany.
              </p>
              <% } %>
            </div>
          </div>

          <!-- WIDOK 2: hasło -->
          <div id="view-password" class="login-view">
            <div class="mb-8 text-center">
              <h2 class="text-2xl font-bold text-gray-900 mb-2">Wpisz hasło</h2>
              <p class="text-gray-500 text-sm">
                Hasło wysłaliśmy wcześniej na Twój adres email
              </p>
            </div>

            <div
              class="mb-5 flex items-center justify-between gap-3 px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl"
            >
              <div class="flex items-center gap-2 min-w-0">
                <svg
                  class="h-4 w-4 text-gray-400 flex-shrink-0"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"
                  />
                </svg>
                <span
                  id="password-email"
                  class="text-sm text-gray-700 font-medium truncate"
                ></span>
              </div>
              <button
                type="button"
                id="btn-change-email"
                class="text-sm text-red-600 hover:text-red-700 font-semibold flex-shrink-0"
              >
                Zmień
              </button>
            </div>

            <div
              id="login-error"
              class="hidden mb-5 p-4 bg-red-50 border border-red-200 rounded-xl flex items-start gap-3"
            >
              <svg
                class="w-5 h-5 text-red-500 mt-0.5 flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <p class="text-red-700 text-sm" id="login-error-text"></p>
            </div>

            <form id="form-password" class="space-y-5">
              <div>
                <label
                  for="password"
                  class="block text-sm font-medium text-gray-700 mb-2"
                  >Hasło</label
                >
                <div class="relative">
                  <div
                    class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
                  >
                    <svg
                      class="h-5 w-5 text-gray-500"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                      />
                    </svg>
                  </div>
                  <input
                    type="password"
                    id="password"
                    autocomplete="current-password"
                    required
                    placeholder="••••••••"
                    class="w-full pl-10 pr-12 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-colors text-gray-900 placeholder-gray-400 bg-gray-50/50"
                  />
                  <button
                    type="button"
                    id="toggle-password"
                    class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600"
                  >
                    <svg
                      id="eye-open"
                      class="h-5 w-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                      />
                    </svg>
                    <svg
                      id="eye-closed"
                      class="h-5 w-5 hidden"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
                      />
                    </svg>
                  </button>
                </div>
              </div>

              <button
                type="submit"
                id="btn-login"
                class="w-full py-3 px-4 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white font-semibold rounded-xl transition-all duration-200 shadow-lg shadow-red-500/30 hover:shadow-red-500/50 hover:-translate-y-0.5 flex items-center justify-center"
              >
                <span class="btn-label">Zaloguj się</span>
              </button>
            </form>

            <p class="mt-5 text-center text-sm text-gray-500">
              Nie pamiętasz hasła?
              <button
                type="button"
                id="btn-reset"
                class="text-red-600 hover:text-red-700 font-semibold"
              >
                Wyślij nowe
              </button>
            </p>
          </div>

          <!-- WIDOK 3: wysłano hasło -->
          <div id="view-sent" class="login-view">
            <div class="text-center">
              <div class="sent-wrap mb-6">
                <span class="sent-ring"></span>
                <div class="sent-circle">
                  <svg
                    class="sent-envelope w-10 h-10 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                </div>
                <span class="sent-badge">
                  <svg
                    class="w-4 h-4 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="3"
                      d="M5 13l4 4L19 7"
                    />
                  </svg>
                </span>
              </div>

              <h2 class="text-2xl font-bold text-gray-900 mb-3">
                Sprawdź skrzynkę
              </h2>
              <p class="text-gray-500 text-sm leading-relaxed mb-2">
                Jeśli adres
                <strong id="sent-email" class="text-gray-800"></strong> figuruje
                w naszej bazie, wysłaliśmy na niego hasło do logowania.
              </p>
              <p class="text-gray-400 text-xs mb-8">
                Nie widzisz wiadomości? Sprawdź folder spam lub poczekaj kilka
                minut.
              </p>

              <button
                type="button"
                id="btn-back"
                class="w-full py-3 px-4 border border-gray-300 text-gray-700 font-semibold rounded-xl hover:bg-gray-50 transition-colors"
              >
                Wróć do logowania
              </button>
            </div>
          </div>
        </div>

        <div
          class="mt-6 flex items-center justify-center gap-6 text-xs text-gray-400"
        >
          <a href="/pomoc" class="hover:text-gray-600">Pomoc</a>
          <span class="text-gray-300">|</span>
          <a href="/polityka-prywatnosci" class="hover:text-gray-600"
            >Polityka prywatności</a
          >
          <span class="text-gray-300">|</span>
          <a href="/regulamin" class="hover:text-gray-600">Regulamin</a>
        </div>
      </div>
    </div>
  </body>
  <script>
    (function () {
      const views = {
        email: document.getElementById("view-email"),
        password: document.getElementById("view-password"),
        sent: document.getElementById("view-sent"),
      };
      const emailInput = document.getElementById("email");
      const passwordInput = document.getElementById("password");
      let currentEmail = "";

      function show(name) {
        Object.values(views).forEach((v) => v.classList.remove("active"));
        views[name].classList.add("active");
        const focusTarget =
          name === "password"
            ? passwordInput
            : name === "email"
            ? emailInput
            : null;
        if (focusTarget) setTimeout(() => focusTarget.focus(), 350);
      }

      function setLoading(btn, loading) {
        const label = btn.querySelector(".btn-label");
        btn.disabled = loading;
        btn.classList.toggle("opacity-80", loading);
        btn.classList.toggle("cursor-not-allowed", loading);
        if (loading) {
          btn.dataset.label = label.textContent;
          label.innerHTML = '<span class="btn-spinner"></span>';
        } else {
          label.textContent = btn.dataset.label;
        }
      }

      async function postJson(url, body) {
        const res = await fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        return res.json();
      }

      function goSent(email) {
        document.getElementById("sent-email").textContent = email;
        show("sent");
      }

      // KROK 1: email
      document
        .getElementById("form-email")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const email = emailInput.value.toLowerCase().trim();
          if (!email) return;
          const btn = document.getElementById("btn-email");
          setLoading(btn, true);
          try {
            const data = await postJson("/login/sprawdz", { email });
            currentEmail = email;
            if (data.status === "password") {
              document.getElementById("password-email").textContent = email;
              show("password");
            } else {
              goSent(email);
            }
          } catch {
            alert("Błąd połączenia. Spróbuj ponownie.");
          } finally {
            setLoading(btn, false);
          }
        });

      // KROK 2: hasło
      document
        .getElementById("form-password")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const btn = document.getElementById("btn-login");
          const errBox = document.getElementById("login-error");
          errBox.classList.add("hidden");
          setLoading(btn, true);
          try {
            const data = await postJson("/login", {
              email: currentEmail,
              password: passwordInput.value,
            });
            if (data.ok) {
              window.location.href = data.redirect || "/kursy";
            } else {
              document.getElementById("login-error-text").textContent =
                data.error || "Nieprawidłowe hasło.";
              errBox.classList.remove("hidden");
            }
          } catch {
            document.getElementById("login-error-text").textContent =
              "Błąd połączenia. Spróbuj ponownie.";
            errBox.classList.remove("hidden");
          } finally {
            setLoading(btn, false);
          }
        });

      // "Wyślij nowe hasło"
      document
        .getElementById("btn-reset")
        .addEventListener("click", async () => {
          try {
            await postJson("/login/sprawdz", {
              email: currentEmail,
              reset: true,
            });
          } catch {}
          goSent(currentEmail);
        });

      document
        .getElementById("btn-change-email")
        .addEventListener("click", () => show("email"));
      document
        .getElementById("btn-back")
        .addEventListener("click", () => show("email"));

      // Pokaż/ukryj hasło
      document
        .getElementById("toggle-password")
        .addEventListener("click", () => {
          const showPw = passwordInput.type === "password";
          passwordInput.type = showPw ? "text" : "password";
          document
            .getElementById("eye-open")
            .classList.toggle("hidden", showPw);
          document
            .getElementById("eye-closed")
            .classList.toggle("hidden", !showPw);
        });
    })();
  </script>
</html>
