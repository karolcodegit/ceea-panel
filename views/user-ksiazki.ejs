<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <title><%= title || 'Książki — CEEA' %></title>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-slate-900">
  <%- include('partials/header') %>
  <%- include('partials/user-nav', { nav: 'ksiazki' }) %>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8">
    <div class="mb-5 sm:mb-8">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white">Twoje książki</h1>
      <p class="text-sm sm:text-base text-gray-500 dark:text-slate-400 mt-1">Zamówienia książek, statusy i śledzenie przesyłek</p>
    </div>

    <% if (!orders || orders.length === 0) { %>
      <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-200 dark:border-slate-700 p-8 sm:p-12 text-center">
        <div class="w-14 h-14 sm:w-16 sm:h-16 bg-gray-100 dark:bg-slate-700 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 sm:w-8 sm:h-8 text-gray-400 dark:text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
          </svg>
        </div>
        <h3 class="text-base sm:text-lg font-medium text-gray-900 dark:text-white mb-2">Brak zamówień</h3>
        <p class="text-sm sm:text-base text-gray-500 dark:text-slate-400 mb-6">Nie masz jeszcze żadnego zamówienia książki.</p>
        <a href="<%= shopUrl %>" class="inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors font-medium text-sm sm:text-base">
          Przeglądaj książki
        </a>
      </div>
    <% } %>

    <%
      const TONES = {
        amber: 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300',
        blue:  'bg-blue-50 text-blue-700 dark:bg-blue-500/10 dark:text-blue-300',
        green: 'bg-green-50 text-green-700 dark:bg-green-500/10 dark:text-green-300',
        gray:  'bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300',
      };
      const toneCls = (t) => TONES[t] || TONES.gray;
    %>

    <section class="space-y-4 sm:space-y-6">
      <% orders.forEach(order => { %>
        <article class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-gray-200 dark:border-slate-700 overflow-hidden">

          <%# ── Nagłówek zamówienia ── %>
          <div class="px-4 py-4 sm:px-6 sm:py-5 border-b border-gray-100 dark:border-slate-700 flex flex-wrap items-center gap-x-4 gap-y-2">
            <div class="min-w-0 w-full sm:w-auto sm:flex-1">
              <h2 class="text-sm sm:text-base font-bold text-gray-900 dark:text-white truncate">
                <%= order.order_number || ('Zamówienie z ' + order.createdLabel) %>
              </h2>
              <p class="text-xs sm:text-sm text-gray-500 dark:text-slate-400 mt-0.5">
                <%= order.createdLabel %><% if (order.itemsCount) { %> · <%= order.itemsCount %> szt.<% } %>
              </p>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold <%= toneCls(order.statusTone) %>">
              <%= order.statusLabel %>
            </span>
            <% if (order.wantInvoice) { %>
            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300" title="Do tego zamówienia zgłoszono fakturę VAT">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
              Faktura VAT
            </span>
            <% } %>
            <% if (order.amountLabel) { %>
            <span class="max-sm:ml-auto text-sm sm:text-base font-bold text-gray-900 dark:text-white whitespace-nowrap"><%= order.amountLabel %></span>
            <% } %>
          </div>

          <div class="px-4 py-4 sm:px-6 sm:py-5 space-y-5">

            <%# ── Timeline / pasek anulowania ── %>
            <% if (order.status === 'canceled') { %>
              <div class="rounded-xl border border-gray-200 dark:border-slate-600 bg-gray-50 dark:bg-slate-700/40 px-4 py-3 flex items-center gap-3">
                <svg class="w-5 h-5 text-gray-400 dark:text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5m0-4.5l-4.5 4.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="text-sm font-medium text-gray-600 dark:text-slate-300">
                  To zamówienie zostało anulowane. W razie pytań napisz: <a href="mailto:sekretariat@ceea.org.pl" class="text-red-600 dark:text-red-400">sekretariat@ceea.org.pl</a>
                </p>
              </div>
            <% } else { %>
            <ol class="flex items-start w-full">
              <% order._steps.forEach((s, i) => { %>
                <li class="flex-1 <%= i === order._steps.length - 1 ? '' : '' %> flex flex-col items-center text-center relative">
                  <% if (i > 0) { %>
                    <span class="absolute top-2.5 right-1/2 w-full h-0.5 -translate-y-1/2 <%= s.state === 'todo' ? 'bg-gray-200 dark:bg-slate-700' : 'bg-red-500' %>" aria-hidden="true"></span>
                  <% } %>
                  <% if (s.state === 'done') { %>
                    <span class="relative z-10 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-red-600 flex items-center justify-center shrink-0">
                      <svg class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    </span>
                  <% } else if (s.state === 'current') { %>
                    <span class="relative z-10 w-5 h-5 sm:w-6 sm:h-6 rounded-full border-2 border-red-600 bg-white dark:bg-slate-800 flex items-center justify-center shrink-0">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-600 animate-pulse"></span>
                    </span>
                  <% } else { %>
                    <span class="relative z-10 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-gray-200 dark:bg-slate-700 shrink-0"></span>
                  <% } %>
                  <span class="mt-1.5 text-[10px] sm:text-xs font-medium <%= s.state === 'todo' ? 'text-gray-400 dark:text-slate-500' : 'text-gray-700 dark:text-slate-200' %>"><%= s.label %></span>
                  <% if (s.at && s.state === 'done') { %>
                    <span class="text-[9px] sm:text-[10px] text-gray-400 dark:text-slate-500"><%= (order._steps === undefined) ? '' : (s.label === 'Złożone' ? order.createdLabel : (s.label === 'Wysłane' ? order.shippedLabel : '')) %></span>
                  <% } %>
                </li>
              <% }) %>
            </ol>
            <% } %>

            <%# ── Pasek płatności (zamówienie czeka + link tpay) ── %>
            <% if (order.status === 'awaiting_transfer' && order.resumeUrl) { %>
              <div class="rounded-xl border border-amber-200 dark:border-amber-500/30 bg-amber-50 dark:bg-amber-500/10 px-4 py-3 flex flex-wrap items-center gap-x-3 gap-y-2">
                <svg class="w-5 h-5 text-amber-500 dark:text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <p class="flex-1 min-w-40 text-sm font-medium text-amber-800 dark:text-amber-200">
                  To zamówienie czeka na płatność — książki wyślemy zaraz po zaksięgowaniu wpłaty.
                </p>
                <a href="<%= order.resumeUrl %>"
                   class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-red-600 text-white text-sm font-semibold hover:bg-red-700 transition-colors shrink-0">
                  Dokończ płatność
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                </a>
              </div>
            <% } %>

            <%# ── Pozycje ── %>
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-slate-500 mb-2">Zamówione pozycje</h3>
              <ul class="divide-y divide-gray-100 dark:divide-slate-700/60">
                <% order.items.forEach(it => { %>
                  <li class="py-3 flex items-center gap-3 sm:gap-4">
                    <% if (it.image) { %>
                      <img src="<%= it.image %>" alt="Okładka: <%= it.title %>" loading="lazy"
                           class="w-11 h-14 sm:w-12 sm:h-16 object-cover rounded-md border border-gray-200 dark:border-slate-600 shadow-sm shrink-0 bg-gray-100 dark:bg-slate-700">
                    <% } else { %>
                      <span class="w-11 h-14 sm:w-12 sm:h-16 rounded-md bg-red-50 dark:bg-slate-700 border border-red-100 dark:border-slate-600 flex items-center justify-center shrink-0" aria-hidden="true">
                        <svg class="w-5 h-5 sm:w-6 sm:h-6 text-red-300 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                      </span>
                    <% } %>
                    <div class="flex-1 min-w-0">
                      <p class="text-sm font-medium text-gray-900 dark:text-slate-100 leading-snug"><%= it.title %></p>
                      <% if (it.author) { %>
                        <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5 truncate"><%= it.author %></p>
                      <% } %>
                    </div>
                    <div class="text-right shrink-0">
                      <p class="text-sm font-semibold text-gray-900 dark:text-slate-100"><%= (Number(it.price) ? (Number(it.price) * (it.qty || 1)).toFixed(2).replace('.', ',') + ' zł' : '') %></p>
                      <p class="text-xs text-gray-400 dark:text-slate-500 mt-0.5">
                        <%= it.qty || 1 %> szt.<% if ((it.qty || 1) > 1 && Number(it.price)) { %> × <%= Number(it.price).toFixed(2).replace('.', ',') %> zł<% } %>
                      </p>
                    </div>
                  </li>
                <% }) %>
                <% if (order.items.length === 0) { %>
                  <li class="py-2 text-sm text-gray-500 dark:text-slate-400">Szczegóły pozycji niedostępne.</li>
                <% } %>
              </ul>
            </div>

            <%# ── Dostawa + śledzenie ── %>
            <div class="grid sm:grid-cols-2 gap-3">
              <div class="rounded-xl bg-gray-50 dark:bg-slate-700/40 p-3.5 sm:p-4 flex gap-3">
                <span class="w-9 h-9 rounded-lg bg-white dark:bg-slate-600 border border-gray-200 dark:border-slate-500 flex items-center justify-center shrink-0 mt-0.5" aria-hidden="true">
                  <% if (order.delivery_method === 'paczkomat') { %>
                    <svg xmlns="http://w3.org" viewBox="0 0 24 24" width="28" height="28" fill="none">
                      <rect width="24" height="24" rx="5" fill="#FFCD00"/>
                      <path stroke="#1D1D1B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5h15M5.5 19.5V6.5A1.5 1.5 0 017 5h10a1.5 1.5 0 011.5 1.5v13M9.5 5v14.5M14.5 5v14.5M5.5 9h4M5.5 12.5h4M5.5 16h4M14.5 9h4M14.5 12.5h4M14.5 16h4M11.25 8.25h1.5v2.5h-1.5z"/>
                    </svg>
                  <% } else { %>
                    <svg xmlns="http://w3.org" viewBox="0 0 24 24" width="28" height="28" fill="none">
                      <rect width="24" height="24" rx="5" fill="#FFCD00"/>
                      <path stroke="#1D1D1B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="M4.5 11.5L12 5l7.5 6.5M6.5 10v8.5c0 .55.45 1 1 1h9c.55 0 1-.45 1-1V10M12 10.5v4.5m0 0l-1.75-1.75M12 15l1.75-1.75"/>
                    </svg>
                  <% } %>
                </span>
                <div class="min-w-0">
                  <h3 class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-slate-500 mb-1.5">Dostawa</h3>
                  <p class="text-sm font-medium text-gray-900 dark:text-slate-100"><%= order.deliveryLabel %></p>
                  <% if (order.delivery_method === 'paczkomat' && order.parcel_locker_code) { %>
                    <p class="text-sm text-gray-600 dark:text-slate-300 mt-0.5">Paczkomat: <span class="font-semibold"><%= order.parcel_locker_code %></span></p>
                  <% } else if (order.addressLine) { %>
                    <p class="text-sm text-gray-600 dark:text-slate-300 mt-0.5"><%= order.addressLine %></p>
                  <% } %>
                  <% if (order.shippedLabel) { %>
                    <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">Wysłano: <%= order.shippedLabel %></p>
                  <% } %>
                </div>
              </div>

              <% if (order.tracking_number) { %>
              <div class="rounded-xl bg-red-50/60 dark:bg-red-500/5 border border-red-100 dark:border-red-500/20 p-3.5 sm:p-4">
                <h3 class="text-xs font-semibold uppercase tracking-wide text-red-400 dark:text-red-300/70 mb-1.5">Śledzenie przesyłki</h3>
                <p class="text-sm font-mono font-medium text-gray-900 dark:text-slate-100 break-all"><%= order.tracking_number %></p>
                <% if (order.inpostLabel) { %>
                  <p class="text-sm mt-1">
                    <span class="inline-flex items-center gap-1.5 font-medium <%= order.inpostFinal && order.inpost_status === 'delivered' ? 'text-green-700 dark:text-green-300' : 'text-red-700 dark:text-red-300' %>">
                      <span class="w-1.5 h-1.5 rounded-full <%= order.inpostFinal && order.inpost_status === 'delivered' ? 'bg-green-500' : 'bg-red-500 animate-pulse' %>"></span>
                      <%= order.inpostLabel %>
                    </span>
                  </p>
                <% } %>
                <a href="<%= order.trackingUrl %>" target="_blank" rel="noopener noreferrer"
                  class="mt-2.5 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-red-600 text-white text-xs sm:text-sm font-medium hover:bg-red-700 transition-colors">
                  Śledź paczkę
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
                </a>
              </div>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </section>

    <p class="mt-6 text-xs sm:text-sm text-gray-400 dark:text-slate-500 text-center">
      Zamówienie powinno być widoczne, ale go nie ma? Napisz: <a href="mailto:sekretariat@ceea.org.pl" class="text-red-600 dark:text-red-400 font-medium">sekretariat@ceea.org.pl</a>
    </p>
  </main>

  <%- include('partials/footer') %>
</body>
</html>