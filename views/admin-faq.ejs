<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title>FAQ — Panel CEEA</title>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-[#0B1120] transition-colors">
    <%- include('partials/admin-nav', { active: 'faq' }) %>
    <%- include('partials/header') %>

    <div class="lg:pl-64 pt-16">
      <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <% const q = locals.query || {}; %>

        <% if (q.success) { %>
          <div class="mb-4 p-3 bg-green-50 dark:bg-green-500/10 text-green-700 dark:text-green-300 rounded-lg text-sm"><%= q.success %></div>
        <% } %>
        <% if (q.error || locals.error) { %>
          <div class="mb-4 p-3 bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-300 rounded-lg text-sm"><%= q.error || locals.error %></div>
        <% } %>

        <section class="module-card p-4 sm:p-5">

          <div class="flex flex-wrap items-center justify-end gap-3 mb-5">
            <button onclick="openFaqModal()" class="btn btn-sm btn-primary whitespace-nowrap">+ Dodaj pytanie</button>
          </div>

          <div class="module-item p-4 sm:p-5 mb-5 flex flex-wrap items-center gap-2">
            <div class="relative flex-1 min-w-[220px]">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 dark:text-slate-500 pointer-events-none">🔍</span>
              <input type="text" id="search" placeholder="szukaj w pytaniach i odpowiedziach..."
                class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none transition-colors focus:border-red-400 dark:focus:border-red-500" />
            </div>
            <button data-filter="all" class="fbtn px-4 py-2.5 rounded-xl text-sm font-medium bg-red-600 text-white">Wszystkie</button>
            <button data-filter="active" class="fbtn px-4 py-2.5 rounded-xl text-sm font-medium bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200">Widoczne</button>
            <button data-filter="inactive" class="fbtn px-4 py-2.5 rounded-xl text-sm font-medium bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200">Ukryte</button>
          </div>

          <div id="faqTable"></div>

        </section>

        <div id="faqModal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
          <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" onclick="closeFaqModal()"></div>
          <div class="relative bg-white dark:bg-slate-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-slate-700 w-full max-w-2xl p-6 max-h-[90vh] overflow-y-auto">
            <h3 id="modalTitle" class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Dodaj pytanie</h3>
            <form method="POST" action="<%= adminPrefix %>/faq" class="space-y-3">
              <input type="hidden" name="id" id="fId" />

              <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Pytanie *</label>
                <input type="text" name="question" id="fQuestion" required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-gray-900 dark:text-white text-sm outline-none" />
              </div>
              <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Odpowiedź *</label>
                <textarea name="answer" id="fAnswer" rows="6" required
                  class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-gray-900 dark:text-white text-sm outline-none"></textarea>
                <p class="text-xs text-gray-400 dark:text-slate-500 mt-1">Zwykły tekst. Akapity oddzielaj pustą linią – strona zachowa podział (jak dotychczas).</p>
              </div>
              <div class="flex items-center gap-4 pt-1">
                <div>
                  <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Kolejność</label>
                  <input type="number" name="sort_order" id="fSortOrder" min="0" value="0"
                    class="w-28 px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-gray-900 dark:text-white text-sm outline-none" />
                </div>
                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300 cursor-pointer mt-5">
                  <input type="checkbox" name="is_active" id="fActive" value="1" class="w-4 h-4 accent-red-600" checked />
                  Widoczne na stronie
                </label>
              </div>

              <div class="flex gap-2 pt-2">
                <button type="button" onclick="closeFaqModal()" class="btn btn-sm btn-neutral flex-1">Anuluj</button>
                <button type="submit" class="btn btn-sm btn-primary flex-1">Zapisz</button>
              </div>
            </form>
          </div>
        </div>

      </main>
    </div>

    <script>
      const DATA = <%- JSON.stringify(items) %>;
      let filter = 'all';

      function esc(s) {
        return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
      }

      function answerPreview(a) {
        const t = String(a || '').split('\n').filter(x => x.trim()).join(' ');
        return t.length > 160 ? t.slice(0, 160) + '…' : t;
      }

      function deleteFaq(id, question) {
        const short = String(question).length > 60 ? String(question).slice(0, 60) + '…' : question;
        if (!confirm(`Usunąć pytanie:\n„${short}"?`)) return;
        const f = document.createElement('form');
        f.method = 'POST';
        f.action = `<%= adminPrefix %>/faq/${id}/usun`;
        document.body.appendChild(f);
        f.submit();
      }

      const table = new DataTable('#faqTable', {
        csvFilename: 'faq.csv',
        pageSize: 10,
        emptyText: 'Brak pytań w bazie.',
        columns: [
          { key: 'sort_order', label: '#', sortable: true, align: 'right',
            render: p => `<span class="text-gray-500 dark:text-slate-400 font-medium">${p.sort_order}</span>` },
          { key: 'question', label: 'Pytanie',
            sortValue: r => (r.question || '').toLowerCase(),
            csvValue: r => `${r.question}\n${r.answer}`,
            render: p => `
              <div class="font-medium text-gray-900 dark:text-white leading-snug">${esc(p.question)}</div>
              <div class="text-xs text-gray-500 dark:text-slate-400 mt-1 leading-relaxed">${esc(answerPreview(p.answer))}</div>` },
          { key: 'is_active', label: 'Status', sortable: true,
            sortValue: r => r.is_active ? 1 : 0,
            render: p => p.is_active
              ? '<span class="badge badge-green">widoczne</span>'
              : '<span class="badge badge-gray">ukryte</span>' },
          { key: '_actions', label: 'Akcje', align: 'right', sortable: false,
            render: p => `<div class="btn-group">` +
              `<button onclick="openFaqModal('${p.id}')" class="btn btn-xs btn-edit">Edytuj</button>` +
              `<button onclick="deleteFaq('${p.id}', '${String(p.question).replace(/'/g, "\\'")}')" class="btn btn-xs btn-delete">Usuń</button>` +
              `</div>` },
        ],
      });

      function render() {
        const s = document.getElementById('search').value.toLowerCase();
        let rows = DATA.filter(p => {
          const matchS = !s
            || (p.question || '').toLowerCase().includes(s)
            || (p.answer || '').toLowerCase().includes(s);
          const matchF = filter === 'all'
            || (filter === 'active' && p.is_active)
            || (filter === 'inactive' && !p.is_active);
          return matchS && matchF;
        });
        table.setRows(rows);
      }

      function openFaqModal(id) {
        const form = document.querySelector('#faqModal form');
        form.reset();
        document.getElementById('fId').value = '';
        document.getElementById('fSortOrder').value = 0;
        document.getElementById('fActive').checked = true;

        if (id) {
          const p = DATA.find(x => x.id === id);
          if (p) {
            document.getElementById('modalTitle').textContent = 'Edytuj pytanie';
            document.getElementById('fId').value = p.id;
            document.getElementById('fQuestion').value = p.question || '';
            document.getElementById('fAnswer').value = p.answer || '';
            document.getElementById('fSortOrder').value = p.sort_order ?? 0;
            document.getElementById('fActive').checked = !!p.is_active;
          }
        } else {
          document.getElementById('modalTitle').textContent = 'Dodaj pytanie';
          const max = Math.max(0, ...DATA.map(d => Number(d.sort_order) || 0));
          document.getElementById('fSortOrder').value = max + 10;
        }

        document.getElementById('faqModal').classList.remove('hidden');
        document.getElementById('faqModal').classList.add('flex');
      }
      function closeFaqModal() {
        document.getElementById('faqModal').classList.add('hidden');
        document.getElementById('faqModal').classList.remove('flex');
      }

      document.getElementById('search').addEventListener('input', render);
      document.querySelectorAll('.fbtn').forEach(btn => {
        btn.addEventListener('click', () => {
          filter = btn.dataset.filter;
          document.querySelectorAll('.fbtn').forEach(b => {
            const active = b === btn;
            b.className = 'fbtn px-4 py-2.5 rounded-xl text-sm font-medium ' + (active
              ? 'bg-red-600 text-white'
              : 'bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-slate-200');
          });
          render();
        });
      });

      render();
    </script>
  </body>
</html>