<section class="gradient-mesh pt-20 pb-16 px-6">
  <div class="max-w-3xl mx-auto text-center">
    <h1 class="text-5xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-6 leading-tight">
      <%- 'Jak możemy<br><span class="text-red-700">pomóc?</span>' %>
    </h1>
    <p class="text-lg text-gray-500 max-w-xl mx-auto leading-relaxed">
      <%= 'Znajdź odpowiedzi na najczęstsze pytania lub skontaktuj się z naszym zespołem.' %>
    </p>
    <% if (lastUpdated) { %>
      <p class="text-sm text-gray-400 mt-4">
        Ostatnia aktualizacja: <%= new Date(lastUpdated).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }) %>
      </p>
    <% } %>
  </div>
</section>