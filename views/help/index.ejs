<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('../partials/head') %>
    <title><%= title %></title>
  </head>
  <body class="min-h-screen bg-white">
    <%- include('header', { backUrl: '/', backText: 'Wróć do panelu' }) %>

    <main>
      <%- include('hero', { page, lastUpdated }) %> <%- include('categories', {
      categories }) %> <% categories.forEach((category, index) => { %> <%-
      include('faq-section', { id: category.slug, title: category.title, icon:
      category.icon, questions: category.questions, index: index + 1 }) %> <% })
      %> <%- include('contact', { company }) %>
    </main>

    <%- include('footer', { company }) %>

    <script src="/js/help.js"></script>
  </body>
</html>
