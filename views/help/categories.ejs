<section class="max-w-5xl mx-auto px-6 -mt-8 mb-20">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    <% categories.forEach((cat, index) => { %> <% if (cat.questions &&
    cat.questions.length > 0) { %>
    <button
      onclick="scrollToSection('<%= cat.id %>')"
      class="category-card text-left bg-white rounded-2xl p-7 border border-gray-100 shadow-sm hover:shadow-xl hover:border-red-100 hover:shadow-red-100/50 group animate-fade-in"
      style="animation-delay: <%= index * 100 %>ms"
    >
      <div
        class="w-12 h-12 bg-red-50 rounded-2xl flex items-center justify-center mb-5 group-hover:bg-red-100 transition-colors"
      >
        <%- cat.icon %>
      </div>

      <h3
        class="font-bold text-gray-900 text-lg mb-2 group-hover:text-red-700 transition-colors"
      >
        <%= cat.title %>
      </h3>

      <p class="text-sm text-gray-500 leading-relaxed">
        <%= cat.description %>
      </p>

      <div class="mt-3 flex items-center gap-1.5 text-xs text-gray-400">
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <%= cat.questions.length %> <%= cat.questions.length === 1 ? 'pytanie' :
        cat.questions.length < 5 ? 'pytania' : 'pytań' %>
      </div>
    </button>
    <% } %> <% }) %>
  </div>
</section>
