<!-- Cookie Banner - małe okienko po prawej -->
<div id="cookie-banner" class="absolute bottom-4 right-4 z-50 max-w-sm transform translate-y-[150%] opacity-0 transition-all duration-500 ease-out">
    <div class="bg-white rounded-2xl shadow-2xl border border-gray-100 overflow-hidden">
      <!-- Header z gradientem -->
      <div class="bg-gradient-to-r from-blue-600 to-blue-500 px-5 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          <span class="text-white font-semibold text-sm">Pliki cookies</span>
        </div>
        <button onclick="closeBanner()" class="text-white/80 hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      
      <!-- Body -->
      <div class="px-5 py-4">
        <p class="text-sm text-gray-600 leading-relaxed mb-4">
          Używamy technicznych plików cookies do logowania i zapamiętywania preferencji. 
          <a href="/polityka-prywatnosci" class="text-blue-600 hover:text-blue-700 font-medium transition-colors">
            Dowiedz się więcej
          </a>
        </p>
        
        <!-- Przyciski -->
        <div class="flex gap-2">
          <button 
            onclick="rejectCookies()" 
            class="flex-1 px-4 py-2 text-sm font-medium text-gray-500 hover:text-gray-700 hover:bg-gray-50 rounded-xl transition-all duration-200">
            Odrzuć
          </button>
          <button 
            onclick="acceptCookies()" 
            class="flex-1 px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-lg shadow-blue-600/20 transition-all duration-200 hover:shadow-xl active:scale-95">
            Akceptuję
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <script>
  (function() {
    const banner = document.getElementById('cookie-banner');
    const STORAGE_KEY = 'ceea_cookie_consent';
    
    const consent = localStorage.getItem(STORAGE_KEY);
    
    if (!consent) {
      setTimeout(() => {
        banner.classList.remove('translate-y-[150%]', 'opacity-0');
        banner.classList.add('translate-y-0', 'opacity-100');
      }, 1500);
    }
    
    window.acceptCookies = function() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        accepted: true,
        timestamp: new Date().toISOString(),
        necessary: true,
        analytics: false
      }));
      hideBanner();
    };
    
    window.rejectCookies = function() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        accepted: false,
        timestamp: new Date().toISOString(),
        necessary: true,
        analytics: false
      }));
      hideBanner();
    };
    
    window.closeBanner = function() {
      hideBanner();
    };
    
    function hideBanner() {
      banner.classList.add('translate-y-[150%]', 'opacity-0');
      banner.classList.remove('translate-y-0', 'opacity-100');
      setTimeout(() => {
        banner.style.display = 'none';
      }, 500);
    }
  })();
  </script>