<%# Sekcja: KURSY %>
<section class="module-card p-5 mb-6">
  <h2 class="module-title mb-4">Kursy</h2>
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
    <div class="module-item p-4 text-center">
      <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= dash.courses.total %></p>
      <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">kursów w bazie</p>
    </div>
    <div class="module-item p-4 text-center">
      <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= dash.courses.enrollments %></p>
      <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">zapisów łącznie</p>
    </div>
    <div class="module-item p-4 text-center">
      <p class="text-2xl font-bold text-red-600 dark:text-red-400"><%= dash.courses.activeParticipants %></p>
      <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">uczestników aktywnego kursu</p>
    </div>
    <div class="module-item p-4 text-center">
      <p class="text-2xl font-bold text-gray-900 dark:text-white"><%= new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN', maximumFractionDigits: 0 }).format(dash.courses.revenue) %></p>
      <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">przychód 30 dni (kursy)</p>
    </div>
  </div>
  <% if (dash.courses.activeTitle) { %>
    <p class="text-xs text-gray-400 dark:text-slate-500 mt-3">Aktywny kurs: <span class="font-semibold"><%= dash.courses.activeTitle %></span></p>
  <% } %>
</section>
