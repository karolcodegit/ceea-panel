<%#
  Pasek głównych statystyk: Kursy / Zapisy / Użytkownicy / Książki sprzedane / Przychód 30 dni
  Dane: locals.dash
%>
<div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-5 gap-3 mb-6">
  <div class="stat-tile">
    <span class="stat-tile-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg></span>
    <div><p class="stat-tile-label">Kursy</p><p class="stat-tile-value"><%= dash.courses.total %></p></div>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4zm6-4a3 3 0 11-3-3"/></svg></span>
    <div><p class="stat-tile-label">Zapisy łącznie</p><p class="stat-tile-value"><%= dash.courses.enrollments %></p></div>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></span>
    <div><p class="stat-tile-label">Użytkownicy</p><p class="stat-tile-value"><%= dash.usersTotal || '—' %></p></div>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253"/></svg></span>
    <div><p class="stat-tile-label">Książki sprzedane</p><p class="stat-tile-value"><%= dash.books.soldUnits %></p></div>
  </div>
  <div class="stat-tile">
    <span class="stat-tile-icon"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"/></svg></span>
    <div><p class="stat-tile-label">Przychód 30 dni</p><p class="stat-tile-value text-sm pt-1"><%= new Intl.NumberFormat('pl-PL', { style: 'currency', currency: 'PLN' }).format(dash.courses.revenue + dash.books.revenue) %></p></div>
  </div>
</div>
