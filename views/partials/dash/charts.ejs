<%# Sekcja: ODWIEDZINY — wykres 14 dni na całą szerokość (własny licznik page_views)
    Dane: locals.dash (visits, series) %>
<section class="module-card p-5 sm:p-6 mb-6">
  <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
    <div>
      <h2 class="module-title">Odwiedziny ceea.org.pl</h2>
      <p class="text-sm text-gray-500 dark:text-slate-400">Ostatnie 14 dni · własny licznik wejść</p>
    </div>
    <div class="flex gap-4 sm:gap-6 text-center">
      <div><p class="text-xl font-bold text-gray-900 dark:text-white"><%= dash.visits.today %></p><p class="text-xs text-gray-500 dark:text-slate-400">dziś</p></div>
      <div><p class="text-xl font-bold text-gray-900 dark:text-white"><%= dash.visits.week %></p><p class="text-xs text-gray-500 dark:text-slate-400">7 dni</p></div>
      <div><p class="text-xl font-bold text-red-600 dark:text-red-400"><%= dash.visits.month %></p><p class="text-xs text-gray-500 dark:text-slate-400">30 dni</p></div>
    </div>
  </div>
  <% const maxV = Math.max(...dash.series.map(s => s.count), 1); %>
  <div id="visitsChart" class="flex items-end gap-1 sm:gap-1.5 h-32">
    <% dash.series.forEach(s => { %>
      <div class="flex-1 bg-red-500/80 dark:bg-red-500/70 rounded-t hover:bg-red-600 transition-colors"
           data-h="<%= Math.max(s.count ? 6 : 2, Math.round((s.count / maxV) * 100)) %>"
           title="<%= s.label %>: <%= s.count %> wejść"></div>
    <% }) %>
  </div>
  <div class="flex justify-between text-xs text-gray-400 dark:text-slate-500 mt-2">
    <span><%= dash.series[0] ? dash.series[0].label : '' %></span>
    <span>dziś</span>
  </div>
</section>
