<%# Wykres odwiedzin + top strony %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-6 mb-6">
  <section class="lg:col-span-2 module-card p-5 sm:p-6">
    <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
      <div>
        <h2 class="module-title">Odwiedziny ceea.org.pl</h2>
        <p class="text-sm text-gray-500 dark:text-slate-400">Ostatnie 14 dni</p>
      </div>
      <div class="flex gap-4 text-center">
        <div><p class="text-xl font-bold text-gray-900 dark:text-white"><%= dash.visits.today %></p><p class="text-xs text-gray-500 dark:text-slate-400">dziś</p></div>
        <div><p class="text-xl font-bold text-gray-900 dark:text-white"><%= dash.visits.week %></p><p class="text-xs text-gray-500 dark:text-slate-400">7 dni</p></div>
        <div><p class="text-xl font-bold text-red-600 dark:text-red-400"><%= dash.visits.month %></p><p class="text-xs text-gray-500 dark:text-slate-400">30 dni</p></div>
      </div>
    </div>
    <% const maxV = Math.max(...dash.series.map(s => s.count), 1); %>
    <div id="visitsChart" class="flex items-end gap-1 h-28">
      <% dash.series.forEach(s => { %>
        <div class="flex-1 bg-red-500/80 dark:bg-red-500/70 rounded-t hover:bg-red-600 transition-colors"
             data-h="<%= Math.max(s.count ? 6 : 2, Math.round((s.count / maxV) * 100)) %>"
             title="<%= s.label %>: <%= s.count %> wejść"></div>
      <% }) %>
    </div>
    <div class="flex justify-between text-xs text-gray-400 dark:text-slate-500 mt-2">
      <span><%= dash.series[0] ? dash.series[0].label : '' %></span>
      <span>dziś</span>
    </div>
  </section>

  <section class="module-card p-5 sm:p-6">
    <h2 class="module-title mb-1">Najpopularniejsze strony</h2>
    <p class="text-sm text-gray-500 dark:text-slate-400 mb-4">Ostatnie 30 dni</p>
    <% if (!dash.topPages.length) { %>
      <p class="text-sm text-gray-400 dark:text-slate-500 py-6 text-center">Brak danych.</p>
    <% } else { %>
      <ul class="space-y-2">
        <% dash.topPages.forEach((p, i) => { %>
          <li class="flex items-center gap-3">
            <span class="w-6 h-6 rounded-md bg-gray-100 dark:bg-slate-700 text-xs font-semibold text-gray-500 dark:text-slate-300 flex items-center justify-center shrink-0"><%= i + 1 %></span>
            <span class="flex-1 text-sm text-gray-700 dark:text-slate-200 truncate" title="<%= p.path %>"><%= p.path %></span>
            <span class="text-sm font-semibold text-gray-900 dark:text-white shrink-0"><%= p.count %></span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
