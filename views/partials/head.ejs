<script>
  (function () {
    var t = localStorage.getItem('ceea-theme') || 'system';
    var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    if (dark) document.documentElement.classList.add('dark');

    //Stan zwinięcia sidebara ustawiamy PRZED renderem, żeby nie było przeskoku
    try {
      if (localStorage.getItem('adminNavCollapsed') === '1') {
        document.documentElement.classList.add('nav-collapsed');
      }
      if (localStorage.getItem('adminResourcesOpen') === '1') {
        document.documentElement.classList.add('resources-open');
      }
    } catch (e) { /* tryb prywatny — ignorujemy */ }
  })();
</script>

<script src="https://cdn.tailwindcss.com"></script>
