<%

/* ═══════════════════════════════════════════════════════════════
    HEADER USER — pasek górny stron uczestnika (panel kursanta
    oraz strony publiczne: /pomoc, /regulamin itd.).

    LEWA:  logo + „Panel" · PRAWA: akcje · awatar

    Ważne: pasek jest FIXED, więc tuż pod nim renderowany jest
    spacer h-16 — bez niego treść strony wjeżdża POD header
    (nagłówek strony znika pod paskiem).
    ═══════════════════════════════════════════════════════════════
*/
%>

<%# id="userHeader" (NIE "topHeader"): admin-header.css ma regułę
    #topHeader { left: 16rem } pod sidebar admina — to samo id tutaj
    odsuwałoby pasek uczestnika o 16 rem na desktopie. %>
<header
  id="userHeader"
  class="fixed top-0 inset-x-0 z-30 h-16 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-gray-200 dark:border-slate-800"
>
  <div class="flex items-center justify-between h-full gap-3 px-4 lg:px-6">

    <%# ── LEWA: logo + „Panel" ── %>
    <a href="/" class="flex items-center gap-3 min-w-0">
      <span class="bg-white rounded-md px-1.5 py-1 shrink-0 flex items-center">
        <img src="/images/logo-header-color-black.jpg" alt="CEEA Logo" class="xl:h-8 h-6 w-auto" />
      </span>
      <span class="text-gray-300 dark:text-slate-700">|</span>
      <span class="text-sm text-gray-500 dark:text-slate-400 font-medium">Panel</span>
    </a>

    <%# ── PRAWA: akcje + awatar (bez dzwonka — to funkcja admina) ── %>
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <%- include('./header/header-actions') %>
      <%- include('./header/user-menu') %>
    </div>
  </div>
</header>

<%# Odstęp pod fixed header — treść strony zaczyna się POD paskiem %>
<div class="h-16" aria-hidden="true"></div>

<%- include('./flash.ejs') %>