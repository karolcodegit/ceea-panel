<%

/* ═══════════════════════════════════════════════════════════════
    HEADER USER — pasek górny stron uczestnika (panel kursanta
    oraz strony publiczne: /pomoc, /regulamin itd.).

    LEWA:  burger (mobile) + logo · PRAWA: akcje · dane użytkownika

    Ważne: pasek jest FIXED, więc tuż pod nim renderowany jest
    spacer h-16 — bez niego treść strony wjeżdża POD header
    (nagłówek strony znika pod paskiem).

    Logo w headerze pokazuje się tylko na mobile oraz na stronach
    BEZ sidebara (niezalogowani) — na desktopie panelu logo siedzi
    na górze sidebara (user-nav.ejs), żeby nie dublować znaków.

    Na desktopie panelu lewa strona belki pokazuje breadcrumb
    „Panel → bieżąca strona". Nazwa strony pochodzi z locals.title
    (format „Nazwa — CEEA") — bez zmian w trasach.
    ═══════════════════════════════════════════════════════════════
*/

const _hasUser = !!locals.user;
const _initials = _hasUser
  ? ((((locals.user.name || '')[0] || '') + ((locals.user.surname || '')[0] || '')).toUpperCase() || '?')
  : '';
const _fullName = _hasUser
  ? ([locals.user.name, locals.user.surname].filter(Boolean).join(' ') || 'Uczestnik')
  : '';
// „Profil — CEEA" → „Profil" (fallback: samo „Panel" bez strzałki)
const _pageName = String(locals.title || '').split('—')[0].trim();
%>

<%# id="userHeader" (NIE "topHeader"): admin-header.css ma regułę
    #topHeader { left: 16rem } pod sidebar admina — to samo id tutaj
    odsuwałoby pasek uczestnika o 16 rem na desktopie. %>
<header
  id="userHeader"
  class="fixed top-0 inset-x-0 z-30 h-16 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-b border-gray-200 dark:border-slate-800"
>
  <div class="flex items-center justify-between h-full gap-3 px-4 lg:px-6">

    <%# ── LEWA: burger (tylko zalogowani, mobile) + logo ── %>
    <% if (_hasUser) { %>
    <button
      id="navOpen"
      class="lg:hidden p-2 -ml-2 rounded-lg text-gray-500 dark:text-slate-400 hover:bg-gray-100 dark:hover:bg-slate-800 transition-colors"
      aria-label="Otwórz menu"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>
    <% } %>
    <%# Logo: na desktopie panelu (zalogowany) siedzi w sidebarze,
        więc tu pokazujemy je tylko na mobile i na stronach publicznych. %>
    <a href="/" class="flex items-center gap-3 min-w-0<%= _hasUser ? ' lg:hidden' : '' %>">
      <span class="bg-white rounded-md px-1.5 py-1 shrink-0 flex items-center">
        <img src="/images/logo-header-color-black.jpg" alt="CEEA Logo" class="xl:h-8 h-6 w-auto" />
      </span>
    </a>
    <%# Desktop panelu: breadcrumb „Panel → bieżąca strona"
        (jednocześnie drugie dziecko justify-between, więc prawy
        blok zostaje przy prawej krawędzi). %>
    <% if (_hasUser) { %>
    <nav class="hidden lg:flex items-center gap-2 text-sm min-w-0" aria-label="Ścieżka">
      <a href="/kursy" class="font-medium text-gray-500 dark:text-slate-400 hover:text-red-700 dark:hover:text-red-300 transition-colors">Panel</a>
      <% if (_pageName && _pageName !== 'Panel') { %>
      <svg class="w-4 h-4 text-gray-300 dark:text-slate-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
      <span class="font-semibold text-gray-900 dark:text-white truncate" aria-current="page"><%= _pageName %></span>
      <% } %>
    </nav>
    <% } %>

    <%# ── PRAWA: akcje + dane użytkownika na sztywno (bez dropdownu —
        Profil/Ustawienia/Wyloguj są w sidebarze). Dla niezalogowanych
        zostaje dotychczasowe menu (link logowania). ── %>
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <%- include('./header/header-actions') %>
      <% if (_hasUser) { %>
      <div class="flex items-center gap-2.5 pl-1">
        <div class="w-8 h-8 rounded-full bg-red-100 dark:bg-red-500/15 text-red-700 dark:text-red-300 flex items-center justify-center font-bold text-xs shrink-0">
          <%= _initials %>
        </div>
        <div class="hidden sm:block leading-tight min-w-0 max-w-44">
          <p class="text-sm font-semibold text-gray-900 dark:text-white truncate"><%= _fullName %></p>
          <p class="text-xs text-gray-500 dark:text-slate-400 truncate"><%= locals.user.email %></p>
        </div>
      </div>
      <% } else { %>
      <%- include('./header/user-menu') %>
      <% } %>
    </div>
  </div>
</header>

<%# Odstęp pod fixed header — treść strony zaczyna się POD paskiem %>
<div class="h-16" aria-hidden="true"></div>

<%- include('./flash.ejs') %>