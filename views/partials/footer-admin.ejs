<%

/* ═══════════════════════════════════════════════════════════════
   FOOTER — wspólna stopka panelu admina (pasek statusu na dole).
   Podpięta RAZ na końcu partials/header.ejs — renderuje się tylko
   w kontekście panelu (gdy istnieje locals.adminPrefix).

   LEWA:  © rok + CEEA Poznań · data
   PRAWA: wersja panelu (z package.json) · PROD/DEV · Pomoc · Zgłoś błąd
   ═══════════════════════════════════════════════════════════════
*/

  const _fYear = new Date().getFullYear();
  const _fDate = new Date().toLocaleDateString("pl-PL", {
    day: "numeric", month: "long", year: "numeric",
  });
  const _fVersion = locals.panelVersion || "";
  const _fEnv = locals.panelEnv || "DEV";
  const _fMail = locals.supportEmail || "";
  const _fSubject = encodeURIComponent("[Panel CEEA] Zgłoszenie błędu");
  const _fBody = encodeURIComponent(
    "Wersja panelu: " + (_fVersion || "?") + "\n" +
    "Środowisko: " + _fEnv + "\n" +
    "Adres strony: \n\n" +
    "Opis problemu:\n"
  );
%>

<% if (locals.adminPrefix) { %>
<footerAdmin
  id="adminFooter"
  class="fixed bottom-0 inset-x-0 z-30 h-9 bg-white/90 dark:bg-slate-900/90 backdrop-blur-md border-t border-gray-200 dark:border-slate-800 transition-[left] duration-300"
>
  <div class="flex items-center justify-between h-full gap-3 px-4 lg:px-6 text-[11px] leading-none text-gray-500 dark:text-slate-400">

    <%# ── LEWA: copyright + data ── %>
    <div class="flex items-center gap-2 min-w-0">
      <span class="truncate">© <%= _fYear %> CEEA Poznań</span>
      <span class="hidden sm:inline text-gray-300 dark:text-slate-700">·</span>
      <span class="hidden sm:inline truncate"><%= _fDate %></span>
    </div>

    <%# ── PRAWA: wersja + środowisko + linki ── %>
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <% if (_fVersion) { %>
      <span class="px-1.5 py-0.5 rounded-md bg-gray-100 dark:bg-slate-800 font-mono text-[10px] text-gray-600 dark:text-slate-300">v<%= _fVersion %></span>
      <% } %>
      <a href="<%= locals.adminPrefix %>/kontakt" class="hidden sm:inline hover:text-red-600 dark:hover:text-red-400 transition-colors">Pomoc</a>
      <% if (_fMail) { %>
      <a href="mailto:<%= _fMail %>?subject=<%= _fSubject %>&body=<%= _fBody %>" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">Zgłoś błąd</a>
      <% } %>
    </div>
  </div>
</footerAdmin>

<style>
  /* Miejsce na pasek statusu, żeby nie zasłaniał treści strony */
  body { padding-bottom: 2.25rem; }
  /* Ten sam offset od sidebaru co #topHeader (zmienne z admin-nav.ejs) */
  @media (min-width: 1024px) {
    #adminFooter { left: var(--admin-nav-w, 16rem); }
    html.nav-collapsed #adminFooter { left: var(--admin-nav-w-collapsed, 5.5rem); }
  }
</style>
<% } %>