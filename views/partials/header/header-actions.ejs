<%#
  MODUŁ: przyciski-akcje w pasku ("Team Settings" / "+ Invite Member" w FlowAI).
  Każdy route może je przekazać przez locals.headerActions:

    res.locals.headerActions = [
      { href: prefix + '/ustawienia',      label: 'Ustawienia',        icon: 'settings' },
      { href: prefix + '/administratorzy', label: '+ Dodaj',           primary: true },
    ];

  primary: true  → wypełniony prostokąt (jasny motyw: grafit, ciemny: biel)
  primary: false / brak → biały prostokąt z borderem
%><%
  const _actions = locals.headerActions || [];
  const _icon    = locals.adminIcon || (() => '');
%>
<% _actions.forEach(function (a) { %>
  <a href="<%= a.href %>"
     class="header-action <%= a.primary ? 'header-action--primary' : 'header-action--ghost' %>
            hidden sm:inline-flex items-center gap-2 h-10 px-4 rounded-xl text-sm font-semibold transition-all whitespace-nowrap
            <%= a.primary
              ? 'bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm dark:shadow-none hover:opacity-90'
              : 'bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-800 text-gray-700 dark:text-slate-200 shadow-sm dark:shadow-none hover:border-gray-300 dark:hover:border-slate-700 hover:bg-gray-50 dark:hover:bg-slate-800' %>">
    <% if (a.icon) { %><span class="w-4 h-4 shrink-0 inline-flex [&>svg]:w-full [&>svg]:h-full"><%- _icon(a.icon) %></span><% } %>
    <%= a.label %>
  </a>
<% }) %>
