<header class="bg-white border-b border-gray-200 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 gap-3">
      <!-- Logo -->
      <div class="flex items-center gap-3">
        <img src="/images/logo-header-color-black.jpg" alt="CEEA Logo" class="h-8 w-auto">
        <span class="text-gray-300">|</span>
        <span class="text-sm text-gray-500 font-medium">Panel</span>
      </div>

      <!-- Nawigacja -->
      <div class="flex items-center gap-4">
        <% if (typeof user !== 'undefined' && user) { %>
          <!-- Zalogowany uczestnik -->
          <div class="flex items-center gap-2 text-sm text-gray-600">
            <div class="w-8 h-8 bg-red-100 rounded-full flex items-center justify-center">
              <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <span class="hidden sm:block"><%= user.email %></span>
          </div>
          <a href="/logout" class="text-sm text-red-600 hover:text-red-700 font-medium transition-colors">
            Wyloguj
          </a>
          
          <% } else if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <!-- Zalogowany admin -->
            <div class="flex items-center gap-2 text-sm text-gray-600">
              <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center">
                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <span class="hidden sm:block">Administrator</span>
            </div>
            <a href="/admin/wyloguj" class="text-sm text-red-600 hover:text-red-700 font-medium transition-colors">
              Wyloguj
            </a>
          
        <% } else { %>
          <!-- Niezalogowany -->
          <a href="/" class="text-sm text-gray-600 hover:text-gray-900 font-medium">Logowanie</a>
        <% } %>
      </div>
    </div>
  </div>
</header>