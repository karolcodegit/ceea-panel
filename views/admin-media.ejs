<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title>Media — Panel CEEA</title>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-[#0B1120] transition-colors">
    <%- include('partials/admin-nav', { active: 'media' }) %>
    <%- include('partials/header') %>

    <div class="lg:pl-64 pt-16">
      <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <% const q = locals.query || {}; %>

        <% if (!cloudName || !uploadPreset) { %>
          <div class="mb-4 p-4 bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-300 rounded-xl text-sm">
            <strong>Brak CLOUDINARY_CLOUD_NAME lub CLOUDINARY_UPLOAD_PRESET w env panelu.</strong><br>
            Uzupełnij zmienne w Northflank (ENV) i zrestartuj usługę. Preset musi być typu <em>unsigned</em>.
          </div>
        <% } %>
        <% if (cloudName && uploadPreset && !hasAdminApi) { %>
          <div class="mb-4 p-4 bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/30 text-amber-700 dark:text-amber-300 rounded-xl text-sm">
            <strong>Galeria w trybie ograniczonym:</strong> dodaj <code>CLOUDINARY_API_KEY</code> i <code>CLOUDINARY_API_SECRET</code> w env (Settings → Access Keys w Cloudinary), żeby przeglądać i usuwać pliki. Upload działa bez nich.
          </div>
        <% } %>

        <div id="testResult" class="hidden mb-4 p-3 rounded-lg text-sm"></div>

        <section class="module-card p-4 sm:p-5">

          <%# Rząd: zakładki folderów po lewej (przesuwana pigułka), akcje po prawej %>
          <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
            <div class="tabs" data-media-tabs>
              <% folders.forEach(f => { %>
                <a href="#" class="tabs-tab <%= f.id === 'ceea' ? 'is-active' : '' %>" data-folder="<%= f.id %>"><%= f.name %></a>
              <% }) %>
              <span class="tabs-ink" aria-hidden="true"></span>
            </div>
            <div class="flex items-center gap-2">
              <button id="testBtn" class="btn btn-sm btn-neutral whitespace-nowrap">Testuj połączenie</button>
              <% if (cloudName && uploadPreset) { %>
                <button id="uploadBtn" class="btn btn-sm btn-primary whitespace-nowrap">+ Wgraj zdjęcie</button>
              <% } %>
            </div>
          </div>

          <div id="grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4"></div>

          <div class="mt-6 text-center">
            <button id="moreBtn" class="hidden btn btn-sm btn-neutral">Załaduj więcej</button>
          </div>

          <div id="empty" class="hidden text-center py-16 text-gray-400 dark:text-slate-500 text-sm">Brak zdjęć w tym folderze.</div>

        </section>
      </main>
    </div>

    <script src="https://widget.cloudinary.com/v2.0/global/all.js"></script>
    <script>
      const CLOUD = <%- JSON.stringify(cloudName) %>;
      const PRESET = <%- JSON.stringify(uploadPreset) %>;
      const HAS_API = <%- JSON.stringify(hasAdminApi) %>;

      let currentFolder = '';
      let nextCursor = null;
      const grid = document.getElementById('grid');
      const moreBtn = document.getElementById('moreBtn');
      const emptyEl = document.getElementById('empty');

      function esc(s) { return String(s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

      async function load(reset) {
        if (reset) { grid.innerHTML = ''; nextCursor = null; emptyEl.classList.add('hidden'); }
        if (!HAS_API) { emptyEl.textContent = 'Galeria wymaga CLOUDINARY_API_KEY i CLOUDINARY_API_SECRET w env.'; emptyEl.classList.remove('hidden'); return; }

        const params = new URLSearchParams({ folder: currentFolder });
        if (nextCursor) params.set('next_cursor', nextCursor);
        const r = await fetch('<%- adminPrefix %>/api/media?' + params);
        const j = await r.json();
        if (!r.ok) { emptyEl.textContent = j.error || 'Błąd pobierania'; emptyEl.classList.remove('hidden'); return; }

        nextCursor = j.next_cursor;
        moreBtn.classList.toggle('hidden', !nextCursor);

        if (reset && j.resources.length === 0) emptyEl.classList.remove('hidden');

        j.resources.forEach(x => {
          const card = document.createElement('div');
          card.className = 'card group overflow-hidden';
          card.innerHTML = `
            <div class="aspect-[4/3] bg-gray-100 dark:bg-slate-900 flex items-center justify-center overflow-hidden">
              <img src="${x.thumb}" alt="${esc(x.public_id)}" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
            </div>
            <div class="p-2.5 space-y-1.5">
              <p class="text-[11px] text-gray-500 dark:text-slate-400 truncate font-mono" title="${esc(x.public_id)}">${esc(x.public_id)}</p>
              <div class="flex gap-1.5">
                <button class="copyBtn btn btn-xs btn-edit flex-1" data-url="${x.url}">Kopiuj URL</button>
                <button class="delBtn btn btn-xs btn-delete flex-1">Usuń</button>
              </div>
            </div>`;
          card.querySelector('.copyBtn').addEventListener('click', async (e) => {
            await navigator.clipboard.writeText(e.target.dataset.url);
            e.target.textContent = 'Skopiowano!';
            setTimeout(() => { e.target.textContent = 'Kopiuj URL'; }, 1500);
          });
          card.querySelector('.delBtn').addEventListener('click', async (e) => {
            if (!confirm(`Usunąć zdjęcie:\n${x.public_id}?`)) return;
            const r = await fetch('<%- adminPrefix %>/api/media/usun', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ public_id: x.public_id }),
            });
            const j = await r.json();
            if (j.ok) card.remove();
            else alert(j.error || 'Błąd usuwania');
          });
          grid.appendChild(card);
        });
      }

      // Zakładki folderów — przesuwana pigułka
      (function () {
        var root = document.querySelector('[data-media-tabs]');
        if (!root) return;
        var ink = root.querySelector('.tabs-ink');
        var tabs = root.querySelectorAll('.tabs-tab');
        function moveInk(el) {
          if (!el || !ink) return;
          ink.style.left = el.offsetLeft + 'px';
          ink.style.width = el.offsetWidth + 'px';
        }
        tabs.forEach(function (t) {
          t.addEventListener('click', function (e) {
            e.preventDefault();
            tabs.forEach(function (x) { x.classList.remove('is-active'); });
            t.classList.add('is-active');
            moveInk(t);
            currentFolder = t.dataset.folder;
            load(true);
          });
        });
        var activeTab = root.querySelector('.tabs-tab.is-active') || tabs[0];
        moveInk(activeTab);
        currentFolder = activeTab.dataset.folder;   // synchronizacja z aktywnym folderem
        window.addEventListener('resize', function () { moveInk(root.querySelector('.tabs-tab.is-active')); });
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(function () { moveInk(root.querySelector('.tabs-tab.is-active')); });
        }
      })();

      moreBtn.addEventListener('click', () => load(false));

      document.getElementById('uploadBtn')?.addEventListener('click', () => {
        if (!window.cloudinary) return alert('Widget Cloudinary nie załadował się.');
        cloudinary.createUploadWidget(
          {
            cloudName: CLOUD,
            uploadPreset: PRESET,
            folder: currentFolder === '' ? 'ogolne' : currentFolder,
            sources: ['local', 'url', 'camera'],
            multiple: true,
            maxFileSize: 8000000,
            clientAllowedFormats: ['jpg', 'jpeg', 'png', 'webp', 'svg', 'pdf'],
          },
          (error, result) => {
            if (!error && result && result.event === 'success') {
              setTimeout(() => load(true), 800);
            }
          }
        ).open();
      });

      document.getElementById('testBtn').addEventListener('click', async () => {
        const box = document.getElementById('testResult');
        box.classList.remove('hidden');
        box.textContent = 'Testowanie…';
        box.className = 'mb-4 p-3 rounded-lg text-sm bg-gray-100 dark:bg-slate-800 text-gray-700 dark:text-slate-300';
        const r = await fetch('<%- adminPrefix %>/api/media/test');
        const j = await r.json();
        const check = (ok, label) => `${ok ? '✅' : '❌'} ${label}`;
        box.innerHTML =
          `<div class="font-semibold mb-1">${j.ok ? '✅ Cloudinary działa poprawnie' : '❌ Problem z Cloudinary'}</div>` +
          check(j.checks.cloudName, 'CLOUDINARY_CLOUD_NAME') + '<br>' +
          check(j.checks.uploadPreset, 'CLOUDINARY_UPLOAD_PRESET (unsigned)') + '<br>' +
          check(j.checks.apiKey, 'CLOUDINARY_API_KEY') + '<br>' +
          check(j.checks.apiSecret, 'CLOUDINARY_API_SECRET') + '<br>' +
          check(j.checks.adminApi, 'Admin API (usage)') +
          (j.message ? `<div class="mt-1 text-xs opacity-70">${esc(j.message)}</div>` : '');
        box.className = 'mb-4 p-3 rounded-lg text-sm ' + (j.ok
          ? 'bg-green-50 dark:bg-green-500/10 text-green-700 dark:text-green-300'
          : 'bg-red-50 dark:bg-red-500/10 text-red-700 dark:text-red-300');
      });

      load(true);
    </script>
  </body>
</html>