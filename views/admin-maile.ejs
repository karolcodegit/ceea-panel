<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <title>Maile — Panel CEEA</title>
</head>
<body class="min-h-screen bg-gray-50">
  <%- include('partials/admin-nav', { active: 'maile' }) %>

  <div class="lg:pl-64">
    <main class="max-w-3xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
      <h1 class="text-xl sm:text-2xl font-bold text-gray-900 mb-1">Maile</h1>
      <p class="text-gray-500 mb-6 sm:mb-8">Wyślij wiadomość do uczestników</p>

      <% if (sent !== null) { %>
        <div class="mb-6 p-4 bg-green-50 text-green-700 rounded-lg">✓ Wysłano do <%= sent %> odbiorców</div>
      <% } %>

      <form method="POST" action="<%= adminPrefix %>/maile" class="bg-white rounded-xl border border-gray-200 p-5 sm:p-6 space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Odbiorcy</label>
          <select name="courseId" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 outline-none">
            <option value="all">Wszyscy z aktywnym dostępem</option>
            <% courses.forEach(c => { %>
              <option value="<%= c.id %>"><%= c.nameCourse %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Temat</label>
          <input type="text" name="subject" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 outline-none">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Treść</label>
          <textarea name="body" rows="8" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 outline-none"></textarea>
        </div>
        <button type="submit" class="w-full sm:w-auto px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors">
          Wyślij
        </button>
      </form>
    </main>
  </div>
</body>
</html>