<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title>Maile — Panel CEEA</title>
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-[#0B1120] transition-colors">
    <%- include('partials/admin-nav', { active: 'maile' }) %> 
    <%- include('partials/header') %>

    <div class="lg:pl-64 pt-16">
      <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">
        <section class="module-card p-4 sm:p-5">

        <%- include('partials/flash') %>

        <%# ── Nagłówek + statystyki kolejki ── %>
        <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
          <div>
            
           
          </div>
          <div class="flex flex-wrap gap-2 text-xs font-medium">
            <span
              class="px-3 py-1.5 rounded-full bg-blue-50 text-blue-700 dark:bg-blue-500/10 dark:text-blue-300"
            >
              📬 W kolejce: <strong id="chipPending"><%= stats.pending %></strong>
            </span>
            <span
              class="px-3 py-1.5 rounded-full bg-green-50 text-green-700 dark:bg-green-500/10 dark:text-green-300"
            >
              ✅ Dziś wysłano:
              <strong
                ><span id="chipSent"><%= stats.sentToday %></span> /
                <%= stats.limit %></strong
              >
            </span>
            <span
              class="px-3 py-1.5 rounded-full bg-red-50 text-red-700 dark:bg-red-500/10 dark:text-red-300"
            >
              ❌ Błędy: <strong id="chipFailed"><%= stats.failed %></strong>
            </span>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
          <%# ════ LEWA KOLUMNA: szablon + odbiorcy ════ %>
          <div class="space-y-6">
            <section class="module-card p-4 sm:p-5">
              <h2
                class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-3"
              >
                Szablon
              </h2>
              <div class="space-y-2.5">
                <% templates.forEach((t, i) => { %>
                <button
                  type="button"
                  class="tpl-card <%= i === 0 ? 'is-active' : '' %>"
                  data-tpl="<%= t.key %>"
                >
                  <span
                    class="block text-sm font-semibold text-gray-900 dark:text-white"
                    ><%= t.icon %> <%= t.name %></span
                  >
                  <span
                    class="block text-xs text-gray-500 dark:text-slate-400 mt-0.5"
                    ><%= t.description %></span
                  >
                </button>
                <% }) %>
              </div>
            </section>

            <section class="module-card p-4 sm:p-5">
              <h2
                class="text-sm font-semibold text-gray-700 dark:text-slate-300 mb-3"
              >
                Odbiorcy
              </h2>
              <select
                id="courseId"
                class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none transition-colors focus:border-red-400 dark:focus:border-red-500 cursor-pointer"
              >
                <option value="all">Wszyscy z aktywnym dostępem</option>
                <% courses.forEach(c => { %>
                <option value="<%= c.id %>">
                  <%= c.title %><%= c.is_active ? ' (aktywny)' : '' %>
                </option>
                <% }) %>
                <option value="test">🧪 TEST — tylko adres testowy</option>
              </select>
              <p class="text-xs text-gray-400 dark:text-slate-500 mt-2">
                Wybierz „TEST”, żeby wysłać tylko na maila testowego.
              </p>
              <p
                id="courseHint"
                class="text-xs text-gray-400 dark:text-slate-500 mt-1"
              ></p>
            </section>
          </div>

          <%# ════ PRAWA KOLUMNA: treść maila ════ %>
          <section class="lg:col-span-2 module-card p-4 sm:p-5">
            <div class="mb-4">
              <label
                for="subject"
                class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1.5"
                >Temat</label
              >
              <input
                type="text"
                id="subject"
                placeholder="Temat wiadomości…"
                class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none transition-colors focus:border-red-400 dark:focus:border-red-500 focus:ring-2 focus:ring-red-100 dark:focus:ring-red-500/20"
              />
            </div>

            <div class="mb-4">
              <label
                for="preheader"
                class="block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1.5"
                >Preheader
                <span class="font-normal"
                  >(tekst podglądu w skrzynce odbiorczej)</span
                ></label
              >
              <input
                type="text"
                id="preheader"
                placeholder="Krótki tekst widoczny na liście maili przed otwarciem…"
                class="w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none transition-colors focus:border-red-400 dark:focus:border-red-500 focus:ring-2 focus:ring-red-100 dark:focus:ring-red-500/20"
              />
            </div>

            <%# Pola generowane dynamicznie z szablonu %>
            <div id="fieldsWrap" class="space-y-4 mb-5">
              <div class="field-skeleton"></div>
              <div class="field-skeleton"></div>
              <div class="field-skeleton"></div>
            </div>

            <p class="text-xs text-gray-400 dark:text-slate-500 mb-5">
              Zmiana szablonu lub kursu nadpisuje pola wartościami domyślnymi z
              Supabase.
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
              <button
                type="button"
                id="btnPreview"
                onclick="showPreview()"
                class="mail-btn mail-btn-neutral"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
                <span>Podgląd maila</span>
              </button>
              <button
                type="button"
                id="btnSend"
                onclick="submitSend()"
                class="mail-btn mail-btn-primary"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 2 11 13" />
                  <path d="m22 2-7 20-4-9-9-4 20-7z" />
                </svg>
                <span>Dodaj do kolejki</span>
              </button>
            </div>
          </section>
        </div>

        <%# ════ OSTATNIA AKTYWNOŚĆ ════ %>
        <section class="module-card p-4 sm:p-5 mt-6">
          <div class="flex items-center justify-between mb-3">
            <h2 class="text-sm font-semibold text-gray-700 dark:text-slate-300">
              Ostatnia aktywność
            </h2>
            <span class="text-xs text-gray-400 dark:text-slate-500"
              >Ostatnie 20 wpisów</span
            >
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr
                  class="text-left text-xs uppercase tracking-wide text-gray-400 dark:text-slate-500 border-b border-gray-100 dark:border-slate-700"
                >
                  <th class="py-2 pr-4 font-medium">Data</th>
                  <th class="py-2 pr-4 font-medium">Odbiorca</th>
                  <th class="py-2 pr-4 font-medium">Status</th>
                  <th class="py-2 font-medium">Wiadomość</th>
                </tr>
              </thead>
              <tbody>
                <% if (!logs || logs.length === 0) { %>
                <tr>
                  <td
                    colspan="4"
                    class="py-6 text-center text-sm text-gray-400 dark:text-slate-500"
                  >
                    Brak wpisów — nic jeszcze nie wysłano.
                  </td>
                </tr>
                <% } %> <% (logs || []).forEach(l => { %>
                <% const st = (l.status || '').toLowerCase(); %>
                <% const badge = st === 'sent'
                  ? 'bg-green-50 text-green-700 dark:bg-green-500/10 dark:text-green-300'
                  : (st === 'failed' || st === 'error'
                    ? 'bg-red-50 text-red-700 dark:bg-red-500/10 dark:text-red-300'
                    : 'bg-amber-50 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300'); %>
                <tr
                  class="border-b border-gray-50 dark:border-slate-800 last:border-0"
                >
                  <td
                    class="py-2.5 pr-4 text-xs text-gray-500 dark:text-slate-400 whitespace-nowrap"
                  >
                    <%= l.created_at ? new
                    Date(l.created_at).toLocaleString('pl-PL', { day: '2-digit',
                    month: '2-digit', hour: '2-digit', minute: '2-digit' }) :
                    '—' %>
                  </td>
                  <td
                    class="py-2.5 pr-4 text-gray-700 dark:text-slate-300 break-all"
                  >
                    <%= l.recipient_email || l.email || '—' %>
                  </td>
                  <td class="py-2.5 pr-4">
                    <span
                      class="inline-block px-2 py-0.5 rounded-full text-xs font-medium <%= badge %>"
                      ><%= l.status || '—' %></span
                    >
                  </td>
                  <td class="py-2.5 text-gray-500 dark:text-slate-400 text-xs">
                    <%= l.subject || l.template_key || '—' %> <% if
                    (l.error_message) { %>
                    <span class="block text-red-500"><%= l.error_message %></span>
                    <% } %>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </section>
        </section>
      </main>
    </div>

    <%# ════ MODAL PODGLĄDU — dokładny HTML maila ════ %>
    <div id="previewModal" class="hidden fixed inset-0 z-50">
      <div
        class="absolute inset-0 bg-black/50 backdrop-blur-sm"
        onclick="closePreview()"
      ></div>
      <div
        class="relative mx-auto my-5 w-[min(720px,94vw)] max-h-[94vh] flex flex-col bg-white dark:bg-slate-900 rounded-2xl shadow-2xl overflow-hidden"
      >
        <div
          class="flex items-center justify-between gap-3 px-4 sm:px-5 py-3 border-b border-gray-100 dark:border-slate-700"
        >
          <div class="min-w-0">
            <p class="text-xs text-gray-400 dark:text-slate-500">
              Podgląd — przykładowy odbiorca:
              <strong id="previewSample">Anna</strong>
            </p>
            <p
              id="previewSubject"
              class="text-sm font-semibold text-gray-900 dark:text-white truncate"
            ></p>
          </div>
          <button
            type="button"
            onclick="closePreview()"
            class="btn btn-sm btn-neutral shrink-0"
          >
            ✕ Zamknij
          </button>
        </div>
        <iframe
          id="previewFrame"
          title="Podgląd maila"
          class="flex-1 w-full"
          style="min-height: 70vh; background: #f3f4f6"
        ></iframe>
      </div>
    </div>

    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script>
      const PREFIX = "<%= adminPrefix %>";
      const $ = (id) => document.getElementById(id);

      const INPUT_CLS =
        "w-full px-3 py-2.5 rounded-xl border border-gray-200 dark:border-slate-600 bg-white dark:bg-slate-900/60 text-gray-900 dark:text-white text-sm outline-none transition-colors focus:border-red-400 dark:focus:border-red-500 focus:ring-2 focus:ring-red-100 dark:focus:ring-red-500/20";
      const LABEL_CLS =
        "block text-xs font-medium text-gray-500 dark:text-slate-400 mb-1.5";
      const HINT_CLS = "text-xs text-gray-400 dark:text-slate-500 mt-1";

      let currentTemplate =
        document.querySelector(".tpl-card.is-active")?.dataset.tpl || "invite";
      let quill = null;
      let quillKey = null;

      const escHtml = (v) =>
        String(v ?? "").replace(
          /[&<>"']/g,
          (c) =>
            ({
              "&": "&amp;",
              "<": "&lt;",
              ">": "&gt;",
              '"': "&quot;",
              "'": "&#39;",
            }[c])
        );

      // ── Wybór szablonu ──
      document.querySelectorAll(".tpl-card").forEach((card) => {
        card.addEventListener("click", () => {
          document
            .querySelectorAll(".tpl-card")
            .forEach((c) => c.classList.remove("is-active"));
          card.classList.add("is-active");
          currentTemplate = card.dataset.tpl;
          loadTemplateData();
        });
      });

      $("courseId").addEventListener("change", loadTemplateData);

      // ── Pola szablonu (dane z Supabase) ──
      async function loadTemplateData() {
        $("fieldsWrap").innerHTML =
          '<div class="field-skeleton"></div><div class="field-skeleton"></div><div class="field-skeleton"></div>';
        quill = null;
        quillKey = null;
        try {
          const res = await fetch(`${PREFIX}/maile/template-data`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              templateKey: currentTemplate,
              courseId: $("courseId").value,
            }),
          });
          const d = await res.json();
          if (!d.ok) throw new Error(d.error || "Błąd ładowania szablonu");

          $("subject").value = d.subject || "";
          $("preheader").value = d.preheader || "";
          $("courseHint").textContent = d.course
            ? `Dane z kursu: ${d.course.title}`
            : "Brak kursu w Supabase — uzupełnij pola ręcznie.";
          renderFields(d.fields || []);
        } catch (e) {
          $("fieldsWrap").innerHTML = `<p class="text-sm text-red-600 dark:text-red-400">${escHtml(
            e.message
          )}</p>`;
        }
      }

      function renderFields(fields) {
        $("fieldsWrap").innerHTML = fields
          .map((f) => {
            const hint = f.hint
              ? `<p class="${HINT_CLS}">${escHtml(f.hint)}</p>`
              : "";
            if (f.type === "html") {
              return `<div>
                <label class="${LABEL_CLS}">${escHtml(f.label)}</label>
                <div id="quillEditor"></div>
                ${hint}
              </div>`;
            }
            if (f.type === "textarea") {
              return `<div>
                <label class="${LABEL_CLS}">${escHtml(f.label)}</label>
                <textarea data-field="${escHtml(f.key)}" rows="${
                f.rows || 3
              }" class="${INPUT_CLS} resize-y">${escHtml(f.value)}</textarea>
                ${hint}
              </div>`;
            }
            return `<div>
              <label class="${LABEL_CLS}">${escHtml(f.label)}</label>
              <input type="text" data-field="${escHtml(
                f.key
              )}" value="${escHtml(f.value)}" class="${INPUT_CLS}" />
              ${hint}
            </div>`;
          })
          .join("");

        // Edytor Quill dla pola typu html (szablon "Własna treść")
        const htmlField = fields.find((f) => f.type === "html");
        if (htmlField && window.Quill) {
          quillKey = htmlField.key;
          quill = new Quill("#quillEditor", {
            theme: "snow",
            placeholder: "Wpisz treść wiadomości…",
            modules: {
              toolbar: [
                ["bold", "italic", "underline"],
                [{ list: "ordered" }, { list: "bullet" }],
                ["link"],
                ["clean"],
              ],
            },
          });
          if (htmlField.value) quill.root.innerHTML = htmlField.value;
        }
      }

      // ── Zbiór wartości pól ──
      function collectValues() {
        const v = {};
        document
          .querySelectorAll("#fieldsWrap [data-field]")
          .forEach((el) => (v[el.dataset.field] = el.value));
        if (quill && quillKey) v[quillKey] = quill.root.innerHTML;
        return v;
      }

      // ── Podgląd (dokładny HTML maila w iframe) ──
      async function showPreview() {
        const btn = $("btnPreview");
        const label = btn.querySelector("span");
        btn.disabled = true;
        label.textContent = "Renderowanie…";
        try {
          const res = await fetch(`${PREFIX}/maile/preview`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              templateKey: currentTemplate,
              courseId: $("courseId").value,
              subject: $("subject").value,
              preheader: $("preheader").value,
              values: collectValues(),
            }),
          });
          const d = await res.json();
          if (!d.ok) throw new Error(d.error || "Błąd podglądu");
          $("previewSubject").textContent = d.subject || "(bez tematu)";
          $("previewSample").textContent = d.sampleName || "Anna";
          $("previewFrame").srcdoc = d.html;
          $("previewModal").classList.remove("hidden");
          document.body.style.overflow = "hidden";
        } catch (e) {
          alert("Podgląd nieudany: " + e.message);
        } finally {
          btn.disabled = false;
          label.textContent = "Podgląd maila";
        }
      }

      function closePreview() {
        $("previewModal").classList.add("hidden");
        document.body.style.overflow = "";
      }
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closePreview();
      });

      // ── Dodaj do kolejki ──
      function submitSend() {
        const courseId = $("courseId").value;
        const msg =
          courseId === "test"
            ? "Wysłać TEST na adres testowy?"
            : courseId === "all"
            ? "Dodać do kolejki dla WSZYSTKICH z aktywnym dostępem?"
            : "Dodać do kolejki dla zapisanych na wybrany kurs?";
        if (!confirm(msg)) return;

        const form = document.createElement("form");
        form.method = "POST";
        form.action = `${PREFIX}/maile`;
        const add = (name, value) => {
          const i = document.createElement("input");
          i.type = "hidden";
          i.name = name;
          i.value = value;
          form.appendChild(i);
        };
        add("courseId", courseId);
        add("templateKey", currentTemplate);
        add("subject", $("subject").value);
        add("preheader", $("preheader").value);
        add("values", JSON.stringify(collectValues()));
        document.body.appendChild(form);
        form.submit();
      }

      // ── Odświeżanie statystyk kolejki ──
      async function refreshStats() {
        try {
          const res = await fetch(`${PREFIX}/maile/stats`);
          const s = await res.json();
          if (typeof s.pending !== "undefined")
            $("chipPending").textContent = s.pending;
          if (typeof s.sentToday !== "undefined")
            $("chipSent").textContent = s.sentToday;
          if (typeof s.failed !== "undefined")
            $("chipFailed").textContent = s.failed;
        } catch {}
      }
      setInterval(refreshStats, 15000);

      // ── start ──
      loadTemplateData();
    </script>
  </body>
</html>