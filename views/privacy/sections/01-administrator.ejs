<section id="administrator" class="mb-16 scroll-mt-24">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center gap-3">
      <span class="flex items-center justify-center w-8 h-8 bg-red-100 text-red-700 text-sm font-bold rounded-lg">1</span>
      Administrator danych osobowych
    </h2>
    <div class="bg-gray-50 rounded-2xl p-6 border border-gray-100">
      <p class="text-gray-700 mb-4">
        Administratorem danych osobowych przetwarzanych w ramach Panelu CEEA jest:
      </p>
      <div class="bg-white rounded-xl p-5 border border-gray-200 shadow-sm">
        <p class="font-semibold text-gray-900"><%= company.nameCompany %></p>
        <p class="text-gray-600 text-sm mt-1"><%= company.street %> <%= company.numberHome %>, <%= company.zipCode %> <%= company.city %></p>
        <p class="text-gray-600 text-sm">NIP: <%= company.nip %></p>
        <p class="text-gray-600 text-sm">KRS: <%= company.krs %></p>
        <p class="text-gray-600 text-sm mt-2">
          Email: <a href="mailto:sekretariat@ceea.org.pl" class="text-red-600 hover:underline"><%= company?.mail || 'biuro@ceea.org.pl' %></a>
        </p>
      </div>
    </div>
  </section>

          