<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-xl border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <div class="flex items-center justify-center">
            <img src="/images/logo-header-color-black.jpg" alt="CEEA Logo" class="h-8 w-auto" />
        </div>
        <div>
          <span class="font-bold text-gray-900 text-sm tracking-tight">Centrum Pomocy</span>
        </div>
      </a>
      <% if (typeof backUrl !== 'undefined') { %>
        <a href="<%= backUrl %>" class="text-sm font-medium text-gray-500 hover:text-red-700 transition-colors flex items-center gap-1.5">
          <%= backText || 'Wróć' %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      <% } %>
    </div>
  </header>