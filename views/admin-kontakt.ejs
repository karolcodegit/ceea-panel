<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title>Pomoc — Panel CEEA</title>
  </head>
  <body>
    <%- include('partials/admin-nav', { active: 'kontakt' }) %>
    <%- include('partials/header') %>

    <%
      const _initials = (p) => {
        const base = (p.name || p.email || "?").trim();
        const parts = base.includes("@") ? base.split("@")[0].split(/[._-]/) : base.split(/\s+/);
        return parts.filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join("") || "?";
      };
      const _ver = locals.panelVersion || "";
      const _env = locals.panelEnv || "DEV";
      const _mail = locals.supportEmail || "";
      const _bugSubject = encodeURIComponent("[Panel CEEA] Zgłoszenie błędu");
      const _bugBody = encodeURIComponent(
        "Wersja panelu: " + (_ver || "?") + "\n" +
        "Środowisko: " + _env + "\n" +
        "Adres strony: \n\n" +
        "Opis problemu:\n\n" +
        "Co robiłem przed błędem:\n"
      );
    %>

    <div class="lg:pl-64 pt-16">
      <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

        <%# ── Nagłówek ── %>
        <div class="mb-6">
          <h1 class="text-lg font-bold text-gray-900 dark:text-white">Pomoc i kontakt</h1>
          <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5">
            Masz pytanie albo coś nie działa? Najpierw zajrzyj do FAQ — jeśli nie znajdziesz odpowiedzi, napisz bezpośrednio.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 items-start">

          <%# ═══ KONTAKT — karty twórców panelu (z admin_users, is_super) ═══ %>
          <div class="lg:col-span-2 space-y-4">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500">Kontakt do twórcy panelu</h2>

            <% if (support && support.length) { %>
              <% support.forEach((p) => { %>
              <div class="ct-card">
                <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                  <% if (p.avatar_url) { %>
                  <img src="<%= p.avatar_url %>" alt="" class="ct-avatar" />
                  <% } else { %>
                  <span class="ct-initials"><%= _initials(p) %></span>
                  <% } %>
                  <div class="min-w-0 flex-1">
                    <div class="font-semibold text-gray-900 dark:text-white text-sm">
                      <%= p.name || p.email %>
                    </div>
                    <% if (p.position) { %>
                    <div class="text-xs text-gray-500 dark:text-slate-400 mt-0.5"><%= p.position %></div>
                    <% } %>
                    <% if (p.bio) { %>
                    <p class="text-xs text-gray-500 dark:text-slate-400 mt-2 leading-relaxed"><%= p.bio %></p>
                    <% } %>
                  </div>
                </div>
                <div class="flex flex-wrap gap-2 mt-4">
                  <a href="mailto:<%= p.email %>" class="ct-btn ct-btn-primary">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                    <%= p.email %>
                  </a>
                  <% if (p.phone) { %>
                  <a href="tel:<%= String(p.phone).replace(/\s+/g, '') %>" class="ct-btn ct-btn-neutral">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                    <%= p.phone %>
                  </a>
                  <% } %>
                </div>
              </div>
              <% }) %>
            <% } else { %>
              <div class="ct-card text-sm text-gray-500 dark:text-slate-400">
                Brak skonfigurowanego kontaktu.
                <% if (_mail) { %>
                Napisz na
                <a href="mailto:<%= _mail %>" class="text-red-600 dark:text-red-400 hover:underline"><%= _mail %></a>.
                <% } %>
              </div>
            <% } %>
          </div>

          <%# ═══ PRAWA KOLUMNA ═══ %>
          <div class="space-y-5">

            <%# ── Zanim napiszesz ── %>
            <div class="ct-card">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-2">Zanim napiszesz</h2>
              <div class="-mx-2">
                <a href="<%= locals.adminPrefix %>/pomoc" class="ct-link">
                  <%- locals.adminIcon('faq-panel') %>
                  FAQ panelu — kategorie i pytania
                </a>
                <a href="/pomoc" target="_blank" class="ct-link">
                  <%- locals.adminIcon('external-link') %>
                  Publiczna strona pomocy
                </a>
                <a href="<%= locals.adminPrefix %>/ustawienia" class="ct-link">
                  <%- locals.adminIcon('settings') %>
                  Ustawienia panelu
                </a>
              </div>
            </div>

            <%# ── Zgłoś błąd ── %>
            <div class="ct-card">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-2">Coś nie działa?</h2>
              <p class="text-xs text-gray-500 dark:text-slate-400 leading-relaxed mb-3">
                Kliknij poniżej — otworzy się wiadomość e-mail z automatycznie uzupełnioną wersją panelu. Dopisz tylko, co się stało.
              </p>
              <% if (_mail) { %>
              <a href="mailto:<%= _mail %>?subject=<%= _bugSubject %>&body=<%= _bugBody %>" class="ct-btn ct-btn-primary w-full">
                Zgłoś błąd
              </a>
              <% } %>
            </div>

            <%# ── Informacje o systemie ── %>
            <div class="ct-card">
              <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-400 dark:text-slate-500 mb-3">Informacje o systemie</h2>
              <dl class="ct-sys grid grid-cols-2 gap-x-4 gap-y-3">
                <div>
                  <dt>Wersja panelu</dt>
                  <dd><%= _ver ? "v" + _ver : "—" %></dd>
                </div>
                <div>
                  <dt>Środowisko</dt>
                  <dd><%= _env %></dd>
                </div>
                <div>
                  <dt>Data</dt>
                  <dd><%= new Date().toLocaleDateString("pl-PL") %></dd>
                </div>
                <div>
                  <dt>Panel</dt>
                  <dd><%= locals.adminPrefix %></dd>
                </div>
              </dl>
            </div>

          </div>
        </div>

      </main>
    </div>
  </body>
</html>