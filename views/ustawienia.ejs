<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <title>Ustawienia — CEEA</title>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-slate-900">
  <%- include('partials/header') %>

  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-1">Ustawienia</h1>
      <p class="text-gray-500 dark:text-gray-400">Dostosuj panel do siebie</p>
    </div>

    <!-- Motyw -->
    <section class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Motyw</h2>
      <div class="grid grid-cols-3 gap-2" id="themeGroup">
        <button type="button" data-theme="light" class="theme-btn px-3 py-2.5 rounded-lg text-sm font-medium transition-colors">☀️ Jasny</button>
        <button type="button" data-theme="dark" class="theme-btn px-3 py-2.5 rounded-lg text-sm font-medium transition-colors">🌙 Ciemny</button>
        <button type="button" data-theme="system" class="theme-btn px-3 py-2.5 rounded-lg text-sm font-medium transition-colors">💻 Systemowy</button>
      </div>
      <p class="text-xs text-gray-400 dark:text-gray-500 mt-3">Tryb ciemny wdrażamy stopniowo — kolejne strony panelu dostaną wsparcie przy najbliższych zmianach.</p>
    </section>

    <!-- Powiadomienia -->
    <section class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Powiadomienia</h2>
      <form method="POST" action="/ustawienia/powiadomienia">
        <label class="flex items-center justify-between gap-4 cursor-pointer">
          <div>
            <p class="text-sm font-medium text-gray-900 dark:text-gray-100">Nowe materiały</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">Email, gdy do Twojego kursu trafi nowy materiał</p>
          </div>
          <input type="checkbox" name="notify" value="1" onchange="this.form.submit()"
            <%= user.notify_materials !== false ? 'checked' : '' %>
            class="w-5 h-5 accent-red-600 shrink-0">
        </label>
      </form>
    </section>

    <!-- Twoje dane -->
    <section class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-4">Twoje dane</h2>
      <div class="flex flex-col sm:flex-row gap-2">
        <a href="/ustawienia/eksport"
          class="px-4 py-2 text-sm text-center rounded-lg bg-gray-100 dark:bg-slate-700 text-gray-700 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-slate-600 transition-colors">
          Pobierz swoje dane (JSON)
        </a>
        <a href="mailto:kontakt@ceea.org.pl?subject=Usuni%C4%99cie%20konta%20w%20panelu%20CEEA&body=Prosz%C4%99%20o%20usuni%C4%99cie%20konta%20dla%20adresu%3A%20<%= encodeURIComponent(user.email) %>"
          class="px-4 py-2 text-sm text-center rounded-lg text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors">
          Złóż wniosek o usunięcie konta
        </a>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>

  <script>
    (function () {
      var KEY = 'ceea-theme';
      var btns = document.querySelectorAll('.theme-btn');
      function current() { return localStorage.getItem(KEY) || 'system'; }
      function apply(t) {
        var dark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
      }
      function paint() {
        var t = current();
        btns.forEach(function (b) {
          var on = b.dataset.theme === t;
          b.classList.toggle('bg-red-600', on);
          b.classList.toggle('text-white', on);
          b.classList.toggle('bg-gray-100', !on);
          b.classList.toggle('text-gray-700', !on);
        });
      }
      btns.forEach(function (b) {
        b.addEventListener('click', function () {
          localStorage.setItem(KEY, b.dataset.theme);
          apply(b.dataset.theme);
          paint();
        });
      });
      paint();
    })();
  </script>
</body>
</html>