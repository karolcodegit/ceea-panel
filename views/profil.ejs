<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <title>Profil — CEEA</title>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-slate-900">
  <%- include('partials/header') %>

  <main class="max-w-2xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-1">Profil</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">Twoje dane konta</p>

    <% if (sent) { %>
      <div class="mb-6 p-4 bg-green-50 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-lg">
        ✓ Nowe hasło zostało wysłane na Twój adres email.
      </div>
    <% } %>

    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 overflow-hidden mb-8">
      <div class="px-5 sm:px-6 py-5 flex items-center gap-4 border-b border-gray-100 dark:border-slate-700">
        <div class="w-14 h-14 bg-red-100 dark:bg-red-900/40 rounded-full flex items-center justify-center text-red-600 dark:text-red-300 text-xl font-semibold shrink-0">
          <%= ((user.name || user.email || '?').charAt(0)).toUpperCase() %>
        </div>
        <div class="min-w-0">
          <p class="text-lg font-semibold text-gray-900 dark:text-gray-100 truncate"><%= [user.name, user.surname].filter(Boolean).join(' ') || '—' %></p>
          <p class="text-sm text-gray-500 dark:text-gray-400 break-all"><%= user.email %></p>
        </div>
      </div>
      <dl class="divide-y divide-gray-100 dark:divide-slate-700">
        <% const rows = [
          ['Imię', user.name],
          ['Nazwisko', user.surname],
          ['Email', user.email],
          ['Telefon', user.phone],
        ]; %>
        <% rows.forEach(([label, value]) => { %>
          <div class="px-5 sm:px-6 py-4 grid grid-cols-3 gap-4">
            <dt class="text-sm text-gray-500 dark:text-gray-400"><%= label %></dt>
            <dd class="col-span-2 text-sm font-medium text-gray-900 dark:text-gray-100 break-all"><%= value || '—' %></dd>
          </div>
        <% }) %>
      </dl>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-xl border border-gray-200 dark:border-slate-700 p-5 sm:p-6">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">Hasło</h2>
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
        Nie pamiętasz hasła? Wygenerujemy nowe i wyślemy je na <span class="font-medium break-all"><%= user.email %></span>.
      </p>
      <form method="POST" action="/profil/reset-hasla">
        <button type="submit" class="px-5 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition-colors text-sm font-medium">
          Wyślij nowe hasło
        </button>
      </form>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>