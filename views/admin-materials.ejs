<!DOCTYPE html>
<html lang="pl">
<head>
  <%- include('partials/head') %>
  <title><%= course.nameCourse %> — Materiały</title>
  <script src="https://upload-widget.cloudinary.com/global/all.js" type="text/javascript"></script>
</head>
<body class="min-h-screen bg-gray-50 dark:bg-[#0B1120] dark:bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] dark:from-slate-900 dark:via-[#0f172a] dark:to-[#020617] transition-colors">
  <%- include('partials/admin-nav', { active: 'kursy' }) %>
  <%- include('partials/header', { pageTitle: course.nameCourse, pageSubtitle: 'Materiały kursu' }) %>

  <div class="lg:pl-64 pt-16">
    <main class="max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10">

      <div class="mb-5">
        <a href="<%= adminPrefix %>/kursy"
           class="text-sm text-gray-500 hover:text-gray-700 dark:text-slate-400 dark:hover:text-slate-200 transition-colors">
          ← Wróć do kursów
        </a>
      </div>

      <%# Karta: dodaj materiał %>
      <section class="module-card p-5 sm:p-6 mb-6">
        <h2 class="module-title mb-4">Dodaj materiał</h2>

        <form id="materialForm"
              method="POST"
              action="<%= adminPrefix %>/kursy/<%= course.id %>/materials"
              class="space-y-4">

          <input type="text"
                 name="title"
                 id="title"
                 placeholder="Tytuł materiału"
                 required
                 class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-slate-500 focus:ring-2 focus:ring-red-500 outline-none transition-colors">

          <!-- przełącznik źródła -->
          <div class="flex gap-2">
            <button type="button" id="modeFile" class="btn btn-sm btn-primary">Plik</button>
            <button type="button" id="modeLink" class="btn btn-sm btn-neutral">Link</button>
          </div>

          <!-- ukryte pola wypełniane automatycznie -->
          <input type="hidden" name="url" id="fileUrl">
          <input type="hidden" name="type" id="fileType">

          <!-- 🔹 UKRYTY INPUT FILE — fallback dla mobile -->
          <input type="file"
                 id="nativeFileInput"
                 class="hidden"
                 accept="application/pdf,image/*,video/*">

          <div id="fileSection">
            <button type="button"
                    id="uploadBtn"
                    class="w-full py-8 border-2 border-dashed border-gray-300 dark:border-slate-600 rounded-xl text-gray-500 dark:text-slate-400 hover:border-red-400 hover:text-red-600 dark:hover:border-red-400 dark:hover:text-red-300 transition-colors select-none touch-manipulation">
              <span class="text-2xl block mb-1">📁</span>
              <span class="font-medium">Wybierz plik</span><br>
              <span class="text-xs text-gray-400 dark:text-slate-500">
                PDF, wideo, zdjęcia — typ wykrywany automatycznie
              </span>
            </button>

            <div id="preview"
                 class="hidden mt-3 p-3 bg-green-50 dark:bg-green-500/10 rounded-lg flex items-center justify-between gap-3">
              <p class="text-green-700 dark:text-green-300 text-sm truncate">
                ✓ <span id="fileName"></span>
                <span id="fileTypeLabel" class="text-green-500 dark:text-green-400"></span>
              </p>
              <button type="button"
                      id="clearFile"
                      class="text-xs text-gray-400 dark:text-slate-400 hover:text-red-600 dark:hover:text-red-300 shrink-0 transition-colors">
                zmień
              </button>
            </div>
          </div>

          <div id="linkSection" class="hidden">
            <input type="url"
                   id="linkUrl"
                   placeholder="https://…"
                   class="w-full px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg bg-white dark:bg-slate-900 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-slate-500 focus:ring-2 focus:ring-red-500 outline-none transition-colors">
          </div>

          <button type="submit"
                  id="submitBtn"
                  disabled
                  class="w-full sm:w-auto px-6 py-2 bg-gray-300 dark:bg-slate-700 text-white rounded-lg cursor-not-allowed transition-colors">
            Dodaj materiał
          </button>
        </form>
      </section>

      <%# Karta: lista materiałów %>
      <section class="module-card p-4 sm:p-5">
        <h2 class="module-title mb-4">Materiały kursu <span class="text-xs font-normal text-gray-400 dark:text-slate-500">(<%= materials.length %>)</span></h2>

        <%
          const badge = {
            pdf: 'bg-red-50 text-red-600 dark:bg-red-500/10 dark:text-red-400',
            jpg: 'bg-blue-50 text-blue-600 dark:bg-blue-500/10 dark:text-blue-400',
            video: 'bg-purple-50 text-purple-600 dark:bg-purple-500/10 dark:text-purple-400',
            link: 'bg-gray-100 text-gray-600 dark:bg-slate-700 dark:text-slate-300'
          };
          const label = {
            pdf: 'PDF',
            jpg: 'Zdjęcie',
            video: 'Wideo',
            link: 'Link'
          };
        %>

        <% if (materials.length === 0) { %>
          <div class="module-item p-10 text-center text-gray-400 dark:text-slate-500 text-sm">
            Brak materiałów — dodaj pierwszy powyżej.
          </div>
        <% } else { %>
          <div class="space-y-3">
            <% materials.forEach(m => { %>
              <div class="module-item p-4 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
                <div class="flex items-center gap-3 flex-1 min-w-0">
                  <span class="px-2 py-1 rounded text-xs font-semibold shrink-0 <%= badge[m.type] || badge.link %>">
                    <%= label[m.type] || m.type %>
                  </span>
                  <p class="font-medium text-gray-900 dark:text-white truncate">
                    <%= m.title %>
                  </p>
                </div>

                <div class="flex items-center gap-2 shrink-0 pl-2 sm:pl-0">
                  <a href="<%= m.url %>" target="_blank" rel="noopener"
                     class="btn btn-xs btn-edit">Otwórz</a>

                  <form method="POST"
                        action="<%= adminPrefix %>/materials/<%= m.id %>/delete"
                        class="js-confirm"
                        data-confirm="Usunąć materiał „<%= m.title %>"?">
                    <button type="submit" class="btn btn-xs btn-delete">Usuń</button>
                  </form>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </section>

    </main>
  </div>

  <script>
    const uploadBtn = document.getElementById('uploadBtn');
    const nativeFileInput = document.getElementById('nativeFileInput');
    const fileUrl = document.getElementById('fileUrl');
    const fileType = document.getElementById('fileType');
    const title = document.getElementById('title');
    const preview = document.getElementById('preview');
    const fileName = document.getElementById('fileName');
    const fileTypeLabel = document.getElementById('fileTypeLabel');
    const submitBtn = document.getElementById('submitBtn');
    const modeFile = document.getElementById('modeFile');
    const modeLink = document.getElementById('modeLink');
    const fileSection = document.getElementById('fileSection');
    const linkSection = document.getElementById('linkSection');
    const linkUrl = document.getElementById('linkUrl');

    const TYPE_LABELS = { pdf: 'PDF', jpg: 'Zdjęcie', video: 'Wideo', link: 'Link' };

    const CLS_MODE_ACTIVE = 'btn btn-sm btn-primary';
    const CLS_MODE_IDLE = 'btn btn-sm btn-neutral';

    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

    function enableSubmit() {
      const ok = !!fileUrl.value;
      submitBtn.disabled = !ok;
      submitBtn.classList.toggle('bg-gray-300', !ok);
      submitBtn.classList.toggle('dark:bg-slate-700', !ok);
      submitBtn.classList.toggle('cursor-not-allowed', !ok);
      submitBtn.classList.toggle('bg-red-600', ok);
      submitBtn.classList.toggle('hover:bg-red-700', ok);
    }

    function detectType(info) {
      const format = (info.format || '').toLowerCase();
      if (format === 'pdf') return 'pdf';
      if (info.resource_type === 'video') return 'video';
      if (info.resource_type === 'image' || ['jpg', 'jpeg', 'png', 'webp', 'gif', 'heic', 'heif'].includes(format)) return 'jpg';
      return 'link';
    }

    function detectTypeFromFile(file) {
      const type = file.type.toLowerCase();
      const name = file.name.toLowerCase();
      if (type.includes('pdf') || name.endsWith('.pdf')) return 'pdf';
      if (type.includes('video')) return 'video';
      if (type.includes('image') || name.endsWith('.heic') || name.endsWith('.heif')) return 'jpg';
      return 'link';
    }

    function showPreview(name, type) {
      if (!title.value) title.value = name.replace(/\.[^/.]+$/, '');
      fileName.textContent = name;
      fileTypeLabel.textContent = '· ' + (TYPE_LABELS[type] || type);
      preview.classList.remove('hidden');
      enableSubmit();
    }

    const widget = cloudinary.createUploadWidget({
      cloudName: '<%= cloudName %>',
      uploadPreset: '<%= uploadPreset %>',
      resource_type: 'auto',
      sources: ['local', 'url'],
      multiple: false,
      maxFileSize: 50000000,
      clientAllowedFormats: ['pdf', 'mp4', 'mov', 'avi', 'jpg', 'jpeg', 'png', 'webp', 'heic', 'heif'],
      showPoweredBy: false,
    }, (error, result) => {
      if (!error && result && result.event === 'success') {
        fileUrl.value = result.info.secure_url;
        fileType.value = detectType(result.info);
        showPreview(result.info.original_filename || 'Materiał', fileType.value);
      }
    });

    uploadBtn.addEventListener('click', (e) => {
      e.preventDefault();
      if (isMobile) nativeFileInput.click();
      else widget.open();
    });

    nativeFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      uploadBtn.innerHTML = '<span class="text-2xl block mb-1">⏳</span><span class="font-medium">Wysyłanie...</span>';
      uploadBtn.disabled = true;
      const detectedType = detectTypeFromFile(file);
      let resourceType = 'auto';
      if (detectedType === 'jpg') resourceType = 'image';
      else if (detectedType === 'pdf') resourceType = 'image';
      else if (detectedType === 'video') resourceType = 'video';
      else resourceType = 'raw';

      const formData = new FormData();
      formData.append('file', file);
      formData.append('upload_preset', '<%= uploadPreset %>');
      formData.append('resource_type', resourceType);

      try {
        const res = await fetch(`https://api.cloudinary.com/v1_1/<%= cloudName %>/${resourceType}/upload`, {
          method: 'POST',
          body: formData,
          credentials: 'omit',
        });
        const data = await res.json();
        if (data.error) { console.error('Cloudinary error:', data.error); throw new Error(data.error.message); }
        if (!res.ok) throw new Error(`Błąd serwera: ${res.status}`);
        fileUrl.value = data.secure_url;
        fileType.value = detectedType;
        showPreview(file.name, detectedType);
      } catch (err) {
        console.error('Upload error:', err);
        alert('Błąd przesyłania:\n\n' + (err.message || 'Sprawdź połączenie i spróbuj ponownie.'));
      } finally {
        uploadBtn.disabled = false;
        uploadBtn.innerHTML = '<span class="text-2xl block mb-1">📁</span><span class="font-medium">Wybierz plik</span><br><span class="text-xs text-gray-400 dark:text-slate-500">PDF, wideo, zdjęcia — typ wykrywany automatycznie</span>';
        nativeFileInput.value = '';
      }
    });

    document.getElementById('clearFile').addEventListener('click', () => {
      fileUrl.value = '';
      fileType.value = '';
      preview.classList.add('hidden');
      nativeFileInput.value = '';
      enableSubmit();
    });

    function setMode(link) {
      fileSection.classList.toggle('hidden', link);
      linkSection.classList.toggle('hidden', !link);
      modeFile.className = link ? CLS_MODE_IDLE : CLS_MODE_ACTIVE;
      modeLink.className = link ? CLS_MODE_ACTIVE : CLS_MODE_IDLE;
      fileUrl.value = '';
      fileType.value = link ? 'link' : '';
      linkUrl.value = '';
      preview.classList.add('hidden');
      enableSubmit();
    }

    modeFile.addEventListener('click', () => setMode(false));
    modeLink.addEventListener('click', () => setMode(true));

    linkUrl.addEventListener('input', () => {
      fileUrl.value = linkUrl.value.trim();
      fileType.value = 'link';
      enableSubmit();
    });
  </script>
</body>
</html>