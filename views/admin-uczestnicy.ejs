<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title><%= course.nameCourse %> — Uczestnicy</title>
  </head>
  <body>
    <%- include('partials/admin-nav', { active: 'kursy' }) %>
    <%- include('partials/header', { pageTitle: course.nameCourse, pageSubtitle: 'Uczestnicy kursu' }) %>

    <div class="lg:pl-64 pt-16">
      <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8">
        <section class="module-card p-4 sm:p-5">
        <div class="mb-5">
          <a href="<%= adminPrefix %>/kursy" class="btn btn-sm btn-neutral">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
            <span>Wróć do kursów</span>
          </a>
        </div>

        <%# Karta: dodaj uczestnika %>
        <section class="module-card p-5 sm:p-6 mb-6">
          <h2 class="module-title mb-4">Dodaj uczestnika</h2>
          <form method="POST"
                action="<%= adminPrefix %>/kursy/<%= course.id %>/uczestnicy"
                class="flex flex-col sm:flex-row gap-3 sm:gap-4">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="email"
                   name="email"
                   placeholder="Email uczestnika"
                   required
                   class="flex-1 px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-red-500 outline-none bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 placeholder-gray-400 dark:placeholder-slate-500" />
            <button type="submit" class="btn btn-sm btn-primary whitespace-nowrap">Dodaj</button>
          </form>
        </section>

        <%# Karta: lista uczestników (DataTable — sortowanie, paginacja, eksport) %>
        <section class="module-card p-4 sm:p-5">
          <div id="enrollmentsTable"></div>
        </section>
        </section>
      </main>
    </div>

    <script>
      // XSS-safe: "<" w danych zamieniane na sekwencję ucieczki przed wstawieniem do skryptu
      const DATA = <%- JSON.stringify(enrollments).replace(/</g, '\\u003c') %>;
      // esc() — globalny helper z /js/data-table.js (escapuje dane przed wklejeniem do HTML)

      const fmtDate = d => d ? new Date(d).toLocaleDateString('pl-PL') : '—';

      const table = new DataTable('#enrollmentsTable', {
        csvFilename: 'uczestnicy-kursu.csv',
        pageSize: 10,
        emptyText: 'Brak uczestników. Dodaj pierwszego powyżej.',

        // EKSPORT — moduł deklaruje tylko CO eksportujemy
        exportData: rows => ({
          filename: 'uczestnicy-kursu',
          headers: ['Email', 'Status', 'Data zapisu'],
          rows: rows.map(e => [
            e.email || '',
            e.status === 'active' ? 'Aktywny' : (e.status || ''),
            fmtDate(e.created_at),
          ]),
        }),

        columns: [
          { key: 'email', label: 'Email', sortable: true,
            sortValue: r => (r.email || '').toLowerCase(),
            render: e => `<span class="font-medium text-gray-900 dark:text-white break-all">${esc(e.email)}</span>` },
          { key: 'status', label: 'Status', sortable: true,
            sortValue: r => r.status || '',
            csvValue: r => r.status === 'active' ? 'Aktywny' : (r.status || ''),
            render: e => `<span class="badge ${e.status === 'active' ? 'badge-green' : 'badge-gray'}">${e.status === 'active' ? 'Aktywny' : esc(e.status || '—')}</span>` },
          { key: 'created_at', label: 'Data zapisu', sortable: true,
            sortValue: r => r.created_at ? new Date(r.created_at).getTime() : 0,
            csvValue: r => fmtDate(r.created_at),
            render: e => `<span class="text-sm text-gray-500 dark:text-slate-400 whitespace-nowrap">${fmtDate(e.created_at)}</span>` },
        ],
      });

      table.setRows(DATA);
    </script>
  </body>
</html>
