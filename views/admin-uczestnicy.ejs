<!DOCTYPE html>
<html lang="pl">
  <head>
    <%- include('partials/head') %>
    <title><%= course.nameCourse %> — Uczestnicy</title>
  </head>
  <body class="min-h-screen bg-gray-50 dark:bg-slate-900">
    <%- include('partials/admin-nav', { active: 'kursy' }) %>
    <%- include('partials/header', { pageTitle: course.nameCourse, pageSubtitle: 'Uczestnicy kursu' }) %>

    <div class="lg:pl-64 pt-16">
      <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8">

        <div class="mb-5">
          <a href="<%= adminPrefix %>/kursy"
             class="text-sm text-gray-500 dark:text-slate-400 hover:text-gray-700 dark:hover:text-slate-200 transition-colors">
            ← Wróć do kursów
          </a>
        </div>

        <%# Karta: dodaj uczestnika %>
        <section class="module-card p-5 sm:p-6 mb-6">
          <h2 class="module-title mb-4">Dodaj uczestnika</h2>
          <form method="POST"
                action="<%= adminPrefix %>/kursy/<%= course.id %>/uczestnicy"
                class="flex flex-col sm:flex-row gap-3 sm:gap-4">
            <input type="email"
                   name="email"
                   placeholder="Email uczestnika"
                   required
                   class="flex-1 px-4 py-2 border border-gray-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-red-500 outline-none bg-white dark:bg-slate-900 text-gray-900 dark:text-slate-100 placeholder-gray-400 dark:placeholder-slate-500" />
            <button type="submit" class="btn btn-sm btn-primary whitespace-nowrap">Dodaj</button>
          </form>
        </section>

        <%# Karta: lista uczestników %>
        <section class="module-card overflow-hidden">
          <div class="px-5 py-3 border-b border-gray-200 dark:border-slate-700 bg-gray-50 dark:bg-slate-700/50 flex justify-between items-center">
            <h2 class="module-title">Uczestnicy</h2>
            <span class="text-xs text-gray-400 dark:text-slate-500"><%= enrollments.length %> zapisów</span>
          </div>

          <% if (enrollments.length === 0) { %>
            <p class="px-6 py-12 text-center text-gray-400 dark:text-slate-500">
              Brak uczestników. Dodaj pierwszego powyżej.
            </p>
          <% } else { %>

            <!-- MOBILE: karty -->
            <div class="md:hidden divide-y divide-gray-100 dark:divide-slate-700/60">
              <% enrollments.forEach(e => { %>
                <div class="p-4">
                  <p class="font-medium text-gray-900 dark:text-slate-100 break-all">
                    <%= e.email %>
                  </p>
                  <div class="mt-2 flex items-center justify-between gap-3">
                    <span class="badge <%= e.status === 'active' ? 'badge-green' : 'badge-gray' %>">
                      <%= e.status %>
                    </span>
                    <span class="text-sm text-gray-500 dark:text-slate-400 whitespace-nowrap">
                      <%= new Date(e.created_at).toLocaleDateString('pl-PL') %>
                    </span>
                  </div>
                </div>
              <% }) %>
            </div>

            <!-- DESKTOP: tabela -->
            <div class="hidden md:block overflow-x-auto">
              <table class="w-full">
                <thead class="bg-gray-50 dark:bg-slate-700/40 border-b border-gray-200 dark:border-slate-700">
                  <tr>
                    <th class="text-left px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-400">Email</th>
                    <th class="text-left px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-400">Status</th>
                    <th class="text-left px-6 py-3 text-sm font-medium text-gray-500 dark:text-slate-400 whitespace-nowrap">Data zapisu</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-slate-700/60">
                  <% enrollments.forEach(e => { %>
                  <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/40 transition-colors">
                    <td class="px-6 py-4 font-medium text-gray-900 dark:text-slate-100 break-all">
                      <%= e.email %>
                    </td>
                    <td class="px-6 py-4">
                      <span class="badge <%= e.status === 'active' ? 'badge-green' : 'badge-gray' %>">
                        <%= e.status %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-gray-500 dark:text-slate-400 text-sm whitespace-nowrap">
                      <%= new Date(e.created_at).toLocaleDateString('pl-PL') %>
                    </td>
                  </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

          <% } %>
        </section>
      </main>
    </div>
  </body>
</html>